DB_DRIVER=postgres
DB_SOURCE=postgresql://root:secret@localhost:5432/golive_cms?sslmode=disable
SERVER_ADDRESS=0.0.0.0:8080
API_PORT=:8080
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h
PUBLIC_API_URL=http://localhost:8080/api/v1
MAX_UPLOAD_SIZE=50MB
UPLOAD_PATH=./uploads/media

# Gin mode: release (default) | debug | test
# debug seeds the default admin (admin/123456) and dummy data on startup and allows
# the local web origins for CORS. compose.dev.yaml sets it for you; uncomment only
# for running the API outside Docker (`make server`). Never set it in production.
# GIN_MODE=debug
# Comma-separated origins allowed for credentialed CORS (needed in release mode when
# the admin UI is served from another origin), e.g. https://admin.example.com
# CORS_ALLOWED_ORIGINS=

# PASETO v4 Configuration
PASETO_V4_PUBLIC_KEY_HEX=9f54f74bb37729ee1f2cda90be7ffa9b5ae05a2396e239dfcb1e662ee8edc965
PASETO_V4_PRIVATE_KEY_HEX=d590d85a2c5512315212a456693247f1a52a0670024aad740738f54b171d0cf49f54f74bb37729ee1f2cda90be7ffa9b5ae05a2396e239dfcb1e662ee8edc965
PASETO_V4_LOCAL_KEY_HEX=5c65f645d6d867c9c9ee7d2c231ec1984ef0ab0f2fdb3272e9d2dbf70b5b6847
PASETO_ISSUER=golive.auth
PASETO_AUDIENCE=golive.admin
PASETO_ACCESS_KID=k4.pub.2025-09
PASETO_REFRESH_KID=k4.loc.2025-09
COOKIE_DOMAIN=localhost
# The refresh cookie is always Secure unless GIN_MODE=debug. Only in debug mode does
# COOKIE_SECURE (default false) decide it, so the API works over plain HTTP locally.
# IS_DEVELOPMENT is no longer read: GIN_MODE=debug is the development switch.
# COOKIE_SECURE=false

# Collaborative editing (WebSocket server integration)
# Used for server-to-server squash calls after a post is published
COLLAB_SERVER_URL=http://localhost:1234
# Shared secret — must match SQUASH_SECRET in websocket/.env
COLLAB_SQUASH_SECRET=change-me-in-production
# Required (the API refuses to start without it). The WS server sends it to
# GET /internal/users/:id/role for its per-connection role check.
# Must match ROLE_LOOKUP_SECRET in websocket/.env
ROLE_LOOKUP_SECRET=change-me-in-production
# Separate server-to-server listener for /internal/* routes. Keep this port
# private (don't publish/expose it); the WS server's INTERNAL_API_URL points here.
INTERNAL_SERVER_ADDRESS=0.0.0.0:8081