FROM node:22-alpine
WORKDIR /app

ARG PUBLIC_API_URL
ARG SERVER_API_URL

ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV SERVER_API_URL=$SERVER_API_URL

COPY package*.json ./
RUN npm install

# Copy startup script
COPY start-dev-with-themes.sh ./
RUN chmod +x start-dev-with-themes.sh

EXPOSE 4321

CMD ["./start-dev-with-themes.sh"]