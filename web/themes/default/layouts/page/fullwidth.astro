---
/**
 * Full Width Page Layout (#345): a centred title band across the page, then the
 * content, where images an author marks wide or full width (#346) break out of the text
 * column.
 */
import BaseLayout from '../base.astro'
import BlockRenderer from '@/components/BlockRenderer'
import { WIDE_IMAGE_SIZES } from '../../lib/imageSizes'
import { metaDescription } from '@/lib/seo'
import type { Post } from '@gl-admin/lib/api/types'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: Post
  title: string
  description: string
  seo?: SeoMeta
  siteTitle?: string
}

const { post, title, description, seo, siteTitle } = Astro.props
const dek = metaDescription(post.description, 400)
---

<BaseLayout title={title} description={description} seo={seo} siteTitle={siteTitle}>
  <article class="page page--full">
    <header class="page-band">
      <div class="container page-band-inner">
        <h1 class="title">{post.title}</h1>
        {dek && <p class="dek">{dek}</p>}
      </div>
    </header>
    <div class="container">
      <div class="prose measure page-body">
        {post.published_blocks && <BlockRenderer doc={post.published_blocks} imageSizes={WIDE_IMAGE_SIZES} />}
      </div>
    </div>
  </article>
</BaseLayout>
