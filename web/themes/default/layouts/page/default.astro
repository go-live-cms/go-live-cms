---
/**
 * Default Page Layout (#345): the title and excerpt over one reading column.
 */
import BaseLayout from '../base.astro'
import BlockRenderer from '@/components/BlockRenderer'
import PostHeader from '../../components/PostHeader.astro'
import { COLUMN_IMAGE_SIZES } from '../../lib/imageSizes'
import type { Post } from '@gl-admin/lib/api/types'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: Post
  title: string
  description: string
  seo?: SeoMeta
  siteTitle?: string
}

const { post, title, description, seo, siteTitle } = Astro.props
---

<BaseLayout title={title} description={description} seo={seo} siteTitle={siteTitle}>
  <div class="container">
    <article class="page page--default">
      <PostHeader post={post} class="measure" showByline={false} />
      <div class="prose measure page-body">
        {post.published_blocks && <BlockRenderer doc={post.published_blocks} imageSizes={COLUMN_IMAGE_SIZES} />}
      </div>
    </article>
  </div>
</BaseLayout>
