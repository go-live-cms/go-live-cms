---
/**
 * An author's page, /author/{username} (#350): the "Author page" board. Name, avatar
 * initial, bio, website, post count, and the published posts they're credited on,
 * paged like the other lists (Newer / Older; numbered pages are #349).
 */
import BaseLayout from '../base.astro'
import PostListItem from '../../components/PostListItem.astro'
import Pagination from '../../components/Pagination.astro'
import { avatarColor, initial } from '../../lib/avatar'
import { displayName, postCountLabel, safeWebsite, websiteLabel } from '../../lib/authors'
import type { AuthorPageData } from '@/lib/authorPage'
import type { SeoMeta } from '@/lib/seo'

interface Props extends AuthorPageData {
  title: string
  description: string
  seo?: SeoMeta
}

const { title, description, seo, author, postCount, list } = Astro.props
const name = displayName(author)
const website = safeWebsite(author.website)
---

<BaseLayout title={title} description={description} seo={seo} siteTitle={list.siteTitle}>
  <div class="container">
    <header class="archive-header author-header">
      <span class="avatar author-header__avatar" aria-hidden="true" style={`background:${avatarColor(author.username)}`}>{initial(name)}</span>
      <div class="author-header__text">
        <span class="eyebrow">Author</span>
        <h1 class="title">{name}</h1>
        {author.bio && <p class="dek author-bio">{author.bio}</p>}
        <p class="meta">
          {list.page > 1 ? `Page ${list.page} · ${postCountLabel(postCount)}` : postCountLabel(postCount)}
          {website && <> · <a href={website} rel="me noopener">{websiteLabel(website)}</a></>}
        </p>
      </div>
    </header>
    <ul class="post-list">
      {list.posts.map((item) => <PostListItem item={item} headingLevel={2} />)}
    </ul>
    {list.links.newer || list.links.older ? (
      <Pagination links={list.links} />
    ) : (
      <p class="meta list-end">That’s every post by {name}. <a href="/">Back to all posts</a></p>
    )}
  </div>
</BaseLayout>
