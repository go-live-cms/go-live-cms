---
/**
 * Base Layout - Shared HTML structure
 * All theme layouts should extend this
 */
import themeConfig from '../theme.config'
import '@/assets/styles/global.css'
import '../styles/theme.scss'

interface Props {
  title: string
  description: string
  theme?: 'light' | 'dark' | 'system'
}

const { title, description, theme = 'system' } = Astro.props
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Theme preference handler (prevents FOUC) -->
    <script is:inline>
      // Immediately apply theme preference before render
      (function() {
        const storageKey = 'gl-theme-preference'
        const stored = localStorage.getItem(storageKey) || 'system'
        
        let theme = stored
        if (stored === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
    
    <slot name="head" />
  </head>
  <body>
    <slot />
    <slot name="footer-scripts" />
  </body>
</html>
