---
/**
 * Base Layout - the page shell every default-theme layout uses (#345): <head> (SEO,
 * tokens, fonts, styles, the theme script), the site header and footer.
 *
 * It follows core's theme contract (#484, themes/README.md "The theme contract"): the
 * tokens go through resolveThemeTokens, so the site's global styles apply; the theme
 * script is a blocking asset in theme.config.ts; the header and footer are template parts.
 */
import themeConfig from '../theme.config'
import { resolveThemeTokens, themeCssVariables } from '@/lib/themeTokens'
import { getSiteSettings } from '@/lib/siteSettings'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SeoHead from '@/components/SeoHead.astro'
import TemplatePart from '@/components/TemplatePart.astro'
import ThemeScripts from '@/components/ThemeScripts.astro'
import { bodyScripts, scriptDataAttributes } from '@/lib/themeAssets'
import type { SeoMeta } from '@/lib/seo'
import { getMenu, withCurrent } from '@/lib/menus'

interface Props {
  title: string
  description: string
  // Canonical/OG/robots tags (#137), passed by the post route through the layouts.
  seo?: SeoMeta
  // Settings the caller already fetched; base fetches them otherwise.
  siteTitle?: string
  // false skips the menu lookups (the 500 page: the API is likely down).
  menus?: boolean
}

const { title, description, seo = {}, menus = true } = Astro.props
// The menus assigned to the theme's locations (#347), fetched alongside the settings.
const [site, primaryMenu, footerMenu] = await Promise.all([
  getSiteSettings(Astro.locals),
  menus ? getMenu('primary') : null,
  menus ? getMenu('footer') : null,
])
const siteTitle = Astro.props.siteTitle ?? site.title
const path = Astro.url.pathname

// WordPress-style: Get theme assets registered in theme.config.ts
const themeAssets = Astro.locals.themeAssets || {}
// Backward compatibility fallback
const legacyCssPath = Astro.locals.themeCssPath
const tokens = themeCssVariables(resolveThemeTokens(themeConfig, Astro.locals.globalStyles))
// The end of <body> renders the other registered scripts as an expression rather than
// <ThemeScripts placement="body">, which renders the same tags: the component drops a
// space Astro writes here, and the page stays byte-identical to before #484.
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead title={title} description={description} {...seo} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    {/* This theme's own render-blocking scripts (theme-init.js sets data-theme before the
        first paint), also when its layouts stand in for another theme's. */}
    <ThemeScripts scripts={themeConfig.assets?.scripts} placement="head" />

    <link rel="preload" href="/themes/default/fonts/literata/literata-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/themes/default/fonts/inter/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={tokens}></style>

    {themeAssets.styles?.map((style: any) => (
      <link rel="stylesheet" href={style.src} media={style.media || 'all'} />
    ))}
    {!themeAssets.styles?.length && legacyCssPath && (
      <link rel="stylesheet" href={legacyCssPath} />
    )}

    <slot name="head" />
  </head>
  <body>
    <div class="site">
      <TemplatePart slug="header"><SiteHeader siteTitle={siteTitle} menu={withCurrent(primaryMenu?.items ?? [], path)} isHome={path === '/'} /></TemplatePart>
      <main id="content" class="site-main" tabindex="-1">
        <slot />
      </main>
      <TemplatePart slug="footer"><SiteFooter siteTitle={siteTitle} tagline={site.tagline} menu={footerMenu?.items ?? []} /></TemplatePart>
    </div>
    <slot name="footer-scripts" />

    {bodyScripts(themeAssets.scripts).map((script) => (
      <script src={script.src} defer={script.defer} async={script.async} type={script.type} {...scriptDataAttributes(script)}></script>
    ))}
  </body>
</html>
