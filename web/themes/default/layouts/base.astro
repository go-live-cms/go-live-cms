---
/**
 * Base Layout - Shared HTML structure
 * All theme layouts should extend this
 */
import themeConfig from '../theme.config'
import '@/assets/styles/global.css'

interface Props {
  title: string
  description: string
  theme?: 'light' | 'dark' | 'system'
}

const { title, description, theme = 'light' } = Astro.props

// Get theme CSS path injected by middleware (WordPress-style dynamic loading)
const themeCssPath = Astro.locals.themeCssPath || '/themes/default/styles/theme.css'
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- WordPress-style: Dynamically load active theme CSS -->
    <link rel="stylesheet" href={themeCssPath} />
    
    <!-- Theme preference handler (prevents FOUC) -->
    <script is:inline>
      // Immediately apply theme preference before render
      (function() {
        const storageKey = 'gl-theme-preference'
        const stored = localStorage.getItem(storageKey) || 'light'
        
        let theme = stored
        if (stored === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
    
    <slot name="head" />
  </head>
  <body>
    <!-- Debug: Theme indicator -->
    <div style="position: fixed; top: 10px; right: 10px; z-index: 9999; background: #2563eb; color: white; padding: 8px 16px; border-radius: 6px; font-family: monospace; font-size: 12px; font-weight: bold; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">
      🎨 {themeConfig.name} v{themeConfig.version}
    </div>
    
    <slot />
    <slot name="footer-scripts" />
  </body>
</html>
