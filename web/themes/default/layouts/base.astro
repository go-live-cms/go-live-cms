---
/**
 * Base Layout - the page shell every default-theme layout uses (#345): <head> (SEO,
 * tokens, fonts, styles, the theme script), the site header and footer.
 */
import themeConfig from '../theme.config'
import { themeCssVariables } from '../tokens'
import { getSiteSettings } from '@/lib/siteSettings'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SeoHead from '@/components/SeoHead.astro'
import type { SeoMeta } from '@/lib/seo'
import type { NavKey } from '../lib/nav'

interface Props {
  title: string
  description: string
  // Canonical/OG/robots tags (#137), passed by the post route through the layouts.
  seo?: SeoMeta
  // The nav entry for this page (aria-current), if any.
  current?: NavKey
  // Settings the caller already fetched; base fetches them otherwise.
  siteTitle?: string
}

const { title, description, seo = {}, current } = Astro.props
const siteTitle = Astro.props.siteTitle ?? (await getSiteSettings()).title

// WordPress-style: Get theme assets registered in theme.config.ts
const themeAssets = Astro.locals.themeAssets || {}
// Backward compatibility fallback
const legacyCssPath = Astro.locals.themeCssPath
const tokens = themeCssVariables(themeConfig)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead title={title} description={description} {...seo} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    {/* Sets data-theme before the first paint. A plain <script src>, not inline, so it
        works under a CSP of script-src 'self'. */}
    <script src="/themes/default/scripts/theme-init.js" data-storage-key={themeConfig.darkMode.storageKey} is:inline></script>

    <link rel="preload" href="/themes/default/fonts/literata/literata-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/themes/default/fonts/inter/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={tokens}></style>

    {themeAssets.styles?.map((style: any) => (
      <link rel="stylesheet" href={style.src} media={style.media || 'all'} />
    ))}
    {!themeAssets.styles?.length && legacyCssPath && (
      <link rel="stylesheet" href={legacyCssPath} />
    )}

    <slot name="head" />
  </head>
  <body>
    <div class="site">
      <SiteHeader siteTitle={siteTitle} current={current} />
      <main id="content" class="site-main" tabindex="-1">
        <slot />
      </main>
      <SiteFooter siteTitle={siteTitle} />
    </div>
    <slot name="footer-scripts" />

    {themeAssets.scripts?.map((script: any) => (
      <script
        src={script.src}
        defer={script.defer}
        async={script.async}
        type={script.type}
      ></script>
    ))}
  </body>
</html>
