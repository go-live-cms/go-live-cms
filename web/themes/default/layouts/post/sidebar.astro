---
/**
 * Post Layout with Sidebar (#345): the reading column with a sidebar beside it.
 * The design's sidebar holds a table of contents (#351) and the category's other posts
 * (#348, #351); until those land it holds what exists: dates, reading time and terms.
 */
import BaseLayout from '../base.astro'
import BlockRenderer from '@/components/BlockRenderer'
import PostHeader from '../../components/PostHeader.astro'
import FeaturedImage from '../../components/FeaturedImage.astro'
import PostTerms from '../../components/PostTerms.astro'
import AuthorCards from '../../components/AuthorCards.astro'
import { COLUMN_IMAGE_SIZES } from '../../lib/imageSizes'
import { readingMinutes } from '../../lib/posts'
import type { AuthorProfile, Post, TaxonomyTerm } from '@gl-admin/lib/api/types'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: Post
  title: string
  description: string
  seo?: SeoMeta
  terms?: TaxonomyTerm[]
  // "Written by" (#350): the credited authors, in byline order.
  authors?: AuthorProfile[]
  featuredImage?: string | null
  siteTitle?: string
}

const { post, title, description, seo, terms, authors = [], featuredImage, siteTitle } = Astro.props

const dateOf = (value: string) => {
  const d = new Date(value)
  // The API sends 0001-01-01 for a post that was never changed.
  return Number.isNaN(d.getTime()) || d.getFullYear() < 1970 ? null : d
}
const published = dateOf(post.created_at)
const changed = dateOf(post.changed_at)
const updated = changed && published && changed.toDateString() !== published.toDateString() ? changed : null
const minutes = readingMinutes(post.published_blocks)
const format = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<BaseLayout title={title} description={description} seo={seo} current={post.post_type === 'post' ? 'posts' : undefined} siteTitle={siteTitle}>
  <div class="container">
    <div class="post-grid">
      <article class="post post--sidebar">
        <PostHeader post={post} authors={authors} />
        <FeaturedImage src={featuredImage} variant="column" />
        <div class="prose">
          {post.published_blocks && <BlockRenderer doc={post.published_blocks} imageSizes={COLUMN_IMAGE_SIZES} />}
        </div>
        {authors.length > 0 && (
          <footer class="post-end">
            <AuthorCards authors={authors} />
          </footer>
        )}
      </article>

      <aside class="post-aside" aria-label="About this post">
        <div class="post-aside-inner">
          <dl class="post-facts">
            {published && (
              <div>
                <dt class="section-title">Published</dt>
                <dd><time datetime={published.toISOString()}>{format(published)}</time></dd>
              </div>
            )}
            {updated && (
              <div>
                <dt class="section-title">Updated</dt>
                <dd><time datetime={updated.toISOString()}>{format(updated)}</time></dd>
              </div>
            )}
            {minutes && (
              <div>
                <dt class="section-title">Reading time</dt>
                <dd>{minutes} min</dd>
              </div>
            )}
          </dl>
          <PostTerms terms={terms} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
