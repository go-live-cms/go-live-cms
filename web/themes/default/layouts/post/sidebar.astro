---
/**
 * Post Layout with Sidebar (#345): the reading column with a sidebar beside it. The
 * sidebar holds "On this page" (the post's H2s and H3s, from three headings up) and
 * the category's other posts (#351); a post with neither shows its dates and reading
 * time there instead, and "All <category> →" links to the category's archive (#348).
 */
import BaseLayout from '../base.astro'
import BlockRenderer from '@/components/BlockRenderer'
import PostHeader from '../../components/PostHeader.astro'
import FeaturedImage from '../../components/FeaturedImage.astro'
import PostEnd from '../../components/PostEnd.astro'
import RelatedPosts from '../../components/RelatedPosts.astro'
import TableOfContents from '../../components/TableOfContents.astro'
import { COLUMN_IMAGE_SIZES } from '../../lib/imageSizes'
import { readingMinutes, THEME_ELEMENT_IDS } from '../../lib/posts'
import { headingAnchors, tableOfContents } from '@/components/blocks/utils/headingAnchors'
import { loadPostEnd } from '@/lib/relatedPosts'
import { resolveSiteUrl } from '@/lib/seo'
import { getSiteSettings } from '@/lib/siteSettings'
import { formatSiteDate, siteDay } from '@/lib/siteDates'
import type { AuthorProfile, Post } from '@gl-admin/lib/api/types'
import type { LinkedTerm } from '@/lib/termPage'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: Post
  title: string
  description: string
  seo?: SeoMeta
  // Categories and tags, with their archives' URLs (#348).
  terms?: LinkedTerm[]
  // "Written by" (#350): the credited authors, in byline order.
  authors?: AuthorProfile[]
  featuredImage?: string | null
  siteTitle?: string
  // The site's id/slug URL setting, which the post route already fetched (#351).
  urlStructure?: string
}

const { post, title, description, seo, terms, authors = [], featuredImage, siteTitle, urlStructure } = Astro.props
const headings = headingAnchors(post.published_blocks, THEME_ELEMENT_IDS)
const toc = tableOfContents(headings)
const [end, site] = await Promise.all([
  loadPostEnd(post, terms, resolveSiteUrl(Astro.url), { inCategory: true, urlStructure }),
  getSiteSettings(Astro.locals),
])

const dateOf = (value: string) => {
  const d = new Date(value)
  // The API sends 0001-01-01 for a post that was never changed.
  return Number.isNaN(d.getTime()) || d.getFullYear() < 1970 ? null : d
}
const published = dateOf(post.created_at)
const changed = dateOf(post.changed_at)
const updated = changed && published && siteDay(changed, site) !== siteDay(published, site) ? changed : null
const minutes = readingMinutes(post.published_blocks)
const format = (d: Date) => formatSiteDate(d, site, 'long')
const showFacts = toc.length === 0 && !end.inCategory
---

<BaseLayout title={title} description={description} seo={seo} siteTitle={siteTitle}>
  <div class="container">
    <div class="post-grid">
      <article class="post post--sidebar">
        <PostHeader post={post} authors={authors} terms={terms} />
        <FeaturedImage src={featuredImage} variant="column" />
        <div class="prose">
          {post.published_blocks && <BlockRenderer doc={post.published_blocks} imageSizes={COLUMN_IMAGE_SIZES} headings={headings} />}
        </div>
        <PostEnd postType={post.post_type} terms={terms} authors={authors} end={end} />
      </article>

      <aside class="post-aside" aria-label="About this post">
        <div class="post-aside-inner">
          <TableOfContents entries={toc} />
          {end.inCategory && (
            <section class="aside-list" aria-labelledby="in-category">
              <h2 id="in-category" class="section-title">In {end.inCategory.term.name}</h2>
              <ul class="aside-links">
                {end.inCategory.posts.map((item) => (
                  <li><a href={item.href}>{item.post.title}</a></li>
                ))}
              </ul>
              {end.inCategory.term.href && <a class="aside-all" href={end.inCategory.term.href}>All {end.inCategory.term.name} →</a>}
            </section>
          )}
          {showFacts && (
            <dl class="post-facts">
              {published && (
                <div>
                  <dt class="section-title">Published</dt>
                  <dd><time datetime={published.toISOString()}>{format(published)}</time></dd>
                </div>
              )}
              {updated && (
                <div>
                  <dt class="section-title">Updated</dt>
                  <dd><time datetime={updated.toISOString()}>{format(updated)}</time></dd>
                </div>
              )}
              {minutes && (
                <div>
                  <dt class="section-title">Reading time</dt>
                  <dd>{minutes} min</dd>
                </div>
              )}
            </dl>
          )}
        </div>
      </aside>
    </div>
    <RelatedPosts posts={end.related} />
  </div>
</BaseLayout>
