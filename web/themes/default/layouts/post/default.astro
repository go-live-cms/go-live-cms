---
/**
 * Default Post Layout (#345): one reading column, the featured image at wide width.
 * Hidden until their issues land: author cards (#350), older/newer and related posts
 * (#351).
 */
import BaseLayout from '../base.astro'
import BlockRenderer from '@/components/BlockRenderer'
import PostHeader from '../../components/PostHeader.astro'
import FeaturedImage from '../../components/FeaturedImage.astro'
import PostTerms from '../../components/PostTerms.astro'
import { COLUMN_IMAGE_SIZES } from '../../lib/imageSizes'
import type { Post, TaxonomyTerm } from '@gl-admin/lib/api/types'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: Post
  title: string
  description: string
  seo?: SeoMeta
  terms?: TaxonomyTerm[]
  featuredImage?: string | null
  siteTitle?: string
}

const { post, title, description, seo, terms, featuredImage, siteTitle } = Astro.props
---

<BaseLayout title={title} description={description} seo={seo} current={post.post_type === 'post' ? 'posts' : undefined} siteTitle={siteTitle}>
  <div class="container">
    <article class="post post--default">
      <PostHeader post={post} class="measure" />
      <FeaturedImage src={featuredImage} variant="wide" />
      <div class="prose measure">
        {post.published_blocks && <BlockRenderer doc={post.published_blocks} imageSizes={COLUMN_IMAGE_SIZES} />}
      </div>
      {terms && terms.length > 0 && (
        <footer class="post-end measure">
          <PostTerms terms={terms} />
        </footer>
      )}
    </article>
  </div>
</BaseLayout>
