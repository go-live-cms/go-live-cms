---
/**
 * Wide Post Layout (#345): a centred title, the featured image full bleed, and images
 * and code blocks at the wide width beside a reading column of text. Images an author
 * marks full width (#346, `align`) run edge to edge.
 */
import BaseLayout from '../base.astro'
import BlockRenderer from '@/components/BlockRenderer'
import PostHeader from '../../components/PostHeader.astro'
import FeaturedImage from '../../components/FeaturedImage.astro'
import PostTerms from '../../components/PostTerms.astro'
import { WIDE_IMAGE_SIZES } from '../../lib/imageSizes'
import type { Post, TaxonomyTerm } from '@gl-admin/lib/api/types'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: Post
  title: string
  description: string
  seo?: SeoMeta
  terms?: TaxonomyTerm[]
  featuredImage?: string | null
  siteTitle?: string
}

const { post, title, description, seo, terms, featuredImage, siteTitle } = Astro.props
---

<BaseLayout title={title} description={description} seo={seo} siteTitle={siteTitle}>
  <article class="post post--wide">
    <div class="container">
      <PostHeader post={post} class="wide" centered />
    </div>
    <FeaturedImage src={featuredImage} variant="full" />
    <div class="container">
      <div class="prose measure">
        {post.published_blocks && <BlockRenderer doc={post.published_blocks} imageSizes={WIDE_IMAGE_SIZES} />}
      </div>
      {terms && terms.length > 0 && (
        <footer class="post-end measure">
          <PostTerms terms={terms} />
        </footer>
      )}
    </div>
  </article>
</BaseLayout>
