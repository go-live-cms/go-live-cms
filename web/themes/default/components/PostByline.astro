---
/**
 * Byline (#345): author initials, names, date and reading time. Author names aren't
 * links until author pages exist (#350).
 */
import type { Post } from '@gl-admin/lib/api/types'
import { avatarColor, initial } from '../lib/avatar'
import { authorNames, joinNames, readingMinutes } from '../lib/posts'

interface Props {
  post: Post
  // "list": one line under a list item; "post": two lines in a post header.
  variant?: 'list' | 'post'
}

const { post, variant = 'list' } = Astro.props
const people = post.authors?.length
  ? post.authors.map((a) => ({ id: a.id, name: a.full_name?.trim() || a.username }))
  : [{ id: post.user_id, name: post.username }]
const names = joinNames(authorNames(post))
const date = new Date(post.created_at)
const valid = !Number.isNaN(date.getTime())
const minutes = readingMinutes(post.published_blocks)
const size = variant === 'post' ? 36 : 28
const longDate = { year: 'numeric', month: 'long', day: 'numeric' } as const
const shortDate = { year: 'numeric', month: 'short', day: 'numeric' } as const
---

<div class={`byline meta byline--${variant}`}>
  <span class="avatars" aria-hidden="true">
    {people.slice(0, 3).map((p) => (
      <span class="avatar" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.4)}px;background:${avatarColor(p.id)}`}>{initial(p.name)}</span>
    ))}
  </span>
  {variant === 'post' ? (
    <span class="byline-text">
      {names && <span>By {names}</span>}
      <span>
        {valid && <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', longDate)}</time>}
        {minutes && <> · {minutes} min read</>}
      </span>
    </span>
  ) : (
    <span>
      {names}
      {valid && <> · <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', shortDate)}</time></>}
      {minutes && <> · {minutes} min read</>}
    </span>
  )}
</div>
