---
/**
 * Byline (#345): author initials, names, date and reading time. Credited authors'
 * names link to their author pages (#350); a post with no byline shows its owner,
 * unlinked (they may have no page).
 */
import type { AuthorProfile, Post } from '@gl-admin/lib/api/types'
import { avatarColor, initial } from '../lib/avatar'
import { bylinePeople, nameSeparator } from '../lib/authors'
import { readingMinutes } from '../lib/posts'
import { getSiteSettings } from '@/lib/siteSettings'
import { formatSiteDate } from '@/lib/siteDates'

interface Props {
  post: Post
  // The post page passes the "Written by" authors; lists use the row's own byline.
  authors?: AuthorProfile[]
  // "list": one line under a list item; "post": two lines in a post header.
  variant?: 'list' | 'post'
}

const { post, authors, variant = 'list' } = Astro.props
const people = bylinePeople(authors?.length ? authors : post.authors, post)
const date = new Date(post.created_at)
const valid = !Number.isNaN(date.getTime())
const minutes = readingMinutes(post.published_blocks)
const size = variant === 'post' ? 36 : 28
// The site's language, time zone and date format (#330), fetched once per request.
const site = await getSiteSettings(Astro.locals)
---

<div class={`byline meta byline--${variant}`}>
  <span class="avatars" aria-hidden="true">
    {people.slice(0, 3).map((p) => (
      <span class="avatar" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.4)}px;background:${avatarColor(p.key)}`}>{initial(p.name)}</span>
    ))}
  </span>
  {variant === 'post' ? (
    <span class="byline-text">
      {people.length > 0 && (
        <span>By {people.map((p, i) => (
          <>{nameSeparator(i, people.length)}{p.href ? <a href={p.href}>{p.name}</a> : p.name}</>
        ))}</span>
      )}
      <span>
        {valid && <time datetime={date.toISOString()}>{formatSiteDate(date, site, 'long')}</time>}
        {minutes && <> · {minutes} min read</>}
      </span>
    </span>
  ) : (
    <span>
      {people.map((p, i) => (
        <>{nameSeparator(i, people.length)}{p.href ? <a href={p.href}>{p.name}</a> : p.name}</>
      ))}
      {valid && <>{people.length > 0 && ' · '}<time datetime={date.toISOString()}>{formatSiteDate(date, site, 'short')}</time></>}
      {minutes && <> · {minutes} min read</>}
    </span>
  )}
</div>
