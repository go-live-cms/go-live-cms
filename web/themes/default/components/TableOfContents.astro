---
/**
 * "On this page" (#351): the post's H2s with their H3s nested, linking to the heading
 * ids the renderer gives them. The caller passes tableOfContents(...), which is empty
 * for a post with fewer than three headings; then this renders nothing.
 */
import type { TocEntry } from '@/components/blocks/utils/headingAnchors'

interface Props {
  entries: TocEntry[]
}

const { entries } = Astro.props
---

{entries.length > 0 && (
  <nav class="toc-block" aria-labelledby="toc-title">
    <h2 id="toc-title" class="section-title">On this page</h2>
    <ol class="toc">
      {entries.map((entry) => (
        <li>
          <a href={`#${entry.id}`}>{entry.text}</a>
          {entry.children.length > 0 && (
            <ol class="toc toc--nested">
              {entry.children.map((child) => (
                <li><a href={`#${child.id}`}>{child.text}</a></li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
