---
/**
 * The post's categories, tags, ... grouped by taxonomy type (#167), as chips (#345).
 * They aren't links until category and tag archives exist (#348).
 * Renders nothing when the post has no terms.
 */
import type { TaxonomyTerm } from '@gl-admin/lib/api/types'
import { getTaxonomyTypes } from '@/lib/api'

interface Props {
  terms?: TaxonomyTerm[]
}

const { terms = [] } = Astro.props

// Keeps the API's order (by type, then name)
const groups = new Map<string, TaxonomyTerm[]>()
for (const term of terms) {
  const type = term.taxonomy_type_name || 'terms'
  groups.set(type, [...(groups.get(type) ?? []), term])
}

// Headings use each type's configured label; its name if the lookup fails
const labels = new Map<string, string>()
if (groups.size > 0) {
  try {
    for (const type of await getTaxonomyTypes()) labels.set(type.name, type.label)
  } catch (error) {
    console.warn('[PostTerms] Could not fetch taxonomy types:', error)
  }
}
const label = (type: string) => labels.get(type) ?? type
---

{groups.size > 0 && (
  <dl class="post-terms">
    {[...groups].map(([type, list]) => (
      <div class={`tag-row post-terms__group post-terms__group--${type}`}>
        <dt class="section-title">{label(type)}</dt>
        {list.map((term) => (
          <dd class="chip post-terms__term" data-slug={term.slug}>{term.name}</dd>
        ))}
      </div>
    ))}
  </dl>
)}
