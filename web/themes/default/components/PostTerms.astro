---
/**
 * The post's categories, tags, ... grouped by taxonomy type (#167), as chips (#345).
 * A term of a public taxonomy links to its archive (#348): the post route passes its
 * `href` (lib/termPage.ts linkTerms) along with its taxonomy's label.
 * Renders nothing when the post has no terms.
 */
import { getTaxonomyTypes } from '@/lib/api'
import type { LinkedTerm } from '@/lib/termPage'

interface Props {
  terms?: LinkedTerm[]
}

const { terms = [] } = Astro.props

// Keeps the API's order (by type, then name)
const groups = new Map<string, LinkedTerm[]>()
for (const term of terms) {
  const type = term.taxonomy_type_name || 'terms'
  groups.set(type, [...(groups.get(type) ?? []), term])
}

// Headings use each type's configured label: the one the route attached, else a
// lookup here (terms passed without labels), else the type's name.
const labels = new Map<string, string>()
for (const term of terms) {
  if (term.taxonomy_type_name && term.taxonomy_label) labels.set(term.taxonomy_type_name, term.taxonomy_label)
}
if ([...groups.keys()].some((type) => !labels.has(type))) {
  try {
    for (const type of await getTaxonomyTypes()) if (!labels.has(type.name)) labels.set(type.name, type.label)
  } catch (error) {
    console.warn('[PostTerms] Could not fetch taxonomy types:', error)
  }
}
const label = (type: string) => labels.get(type) ?? type
---

{groups.size > 0 && (
  <dl class="post-terms">
    {[...groups].map(([type, list]) => (
      <div class={`tag-row post-terms__group post-terms__group--${type}`}>
        <dt class="section-title">{label(type)}</dt>
        {list.map((term) => (
          term.href ? (
            <dd class="post-terms__term" data-slug={term.slug}><a class="chip" href={term.href}>{term.name}</a></dd>
          ) : (
            <dd class="chip post-terms__term" data-slug={term.slug}>{term.name}</dd>
          )
        ))}
      </div>
    ))}
  </dl>
)}
