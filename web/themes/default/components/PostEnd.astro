---
/**
 * The end of a post (#351): its terms, "Written by" (#350), then older / newer links.
 * "More to read" sits below the article (RelatedPosts), at the container's width.
 */
import PostTerms from './PostTerms.astro'
import AuthorCards from './AuthorCards.astro'
import PostNav from './PostNav.astro'
import { archiveLink } from '../lib/posts'
import type { AuthorProfile } from '@gl-admin/lib/api/types'
import type { LinkedTerm } from '@/lib/termPage'
import type { PostEndData } from '@/lib/relatedPosts'

interface Props {
  postType: string
  terms?: LinkedTerm[]
  authors?: AuthorProfile[]
  end: PostEndData
  class?: string
}

const { postType, terms, authors, end, class: className } = Astro.props
const archive = archiveLink(postType)
---

<footer class:list={['post-end', className]}>
  <PostTerms terms={terms} />
  <AuthorCards authors={authors} />
  <PostNav previous={end.previous} next={end.next} archiveHref={archive.href} archiveLabel={archive.label} />
</footer>
