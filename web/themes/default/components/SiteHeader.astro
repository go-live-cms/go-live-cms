---
/**
 * Site header (#345): the site's title as text, the main nav, a link to search (#145),
 * the theme switch and, at phone width, a menu with the same nav, a search field and
 * the same three theme choices.
 *
 * The nav is the menu assigned to the theme's "primary" location (#347). Without one
 * the header shows the site title only. A top-level link with children gets a
 * disclosure button that opens them (scripts/theme-init.js; hover and focus open it
 * without JavaScript); the phone menu lists the children under their parent.
 *
 * Hidden until its issue lands: a site logo (#330, it would replace the title text). GoLive's own mark never appears here, only in the footer
 * credit.
 */
import ThemeSwitch from './ThemeSwitch.astro'
import SearchForm from './SearchForm.astro'
import type { MenuLink } from '@/lib/menus'

interface Props {
  siteTitle: string
  // The primary menu's links, current page marked (withCurrent); empty = no menu.
  menu?: MenuLink[]
  // The page being viewed is the front page.
  isHome?: boolean
}

const { siteTitle, menu = [], isHome = false } = Astro.props
const ariaCurrent = (link: MenuLink) => (link.current ? 'page' : undefined)
const homeCurrent = isHome ? 'page' : undefined
// A parent whose child is the current page is marked too (not aria-current).
const holdsCurrent = (link: MenuLink) => link.current || link.children.some((child) => child.current)
---

<a href="#content" class="skip-link">Skip to content</a>
<header class="site-header">
  <div class="container site-header-inner">
    <a href="/" class="site-title" aria-current={homeCurrent}>{siteTitle}</a>
    {menu.length > 0 && (
      <nav class="site-nav" aria-label="Main">
        {menu.map((link) =>
          link.children.length === 0 ? (
            <a href={link.url} aria-current={ariaCurrent(link)}>{link.label}</a>
          ) : (
            <div class="nav-group" data-nav-group data-current={holdsCurrent(link) ? 'true' : undefined}>
              <a href={link.url} aria-current={ariaCurrent(link)}>{link.label}</a>
              <button
                type="button"
                class="nav-sub-toggle"
                aria-expanded="false"
                aria-controls={`nav-sub-${link.id}`}
                aria-label={`${link.label}: more links`}
                data-nav-sub-toggle
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </button>
              <ul id={`nav-sub-${link.id}`} class="nav-submenu" role="list">
                {link.children.map((child) => (
                  <li><a href={child.url} aria-current={ariaCurrent(child)}>{child.label}</a></li>
                ))}
              </ul>
            </div>
          )
        )}
      </nav>
    )}
    <div class="header-actions">
      <a href="/search" class="icon-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <div class="theme-menu hide-mobile">
        <button
          type="button"
          class="icon-btn"
          aria-label="Theme"
          aria-expanded="false"
          aria-controls="theme-menu"
          data-theme-menu-toggle
        >
          <svg class="icon-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="icon-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          <svg class="icon-system" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>
        </button>
        <div id="theme-menu" class="theme-popover" role="group" aria-label="Theme" hidden>
          <ThemeSwitch variant="menu" />
        </div>
      </div>
      <button
        type="button"
        class="icon-btn menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        data-site-menu-open
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="mobile-menu" aria-label="Menu" data-site-menu>
  <div class="container site-header-inner mobile-menu-bar">
    <a href="/" class="site-title">{siteTitle}</a>
    <button type="button" class="icon-btn" aria-label="Close menu" data-site-menu-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </div>
  <nav aria-label="Main">
    <a href="/" aria-current={homeCurrent}>Home</a>
    {menu.map((link) => (
      <>
        <a href={link.url} aria-current={ariaCurrent(link)}>{link.label}</a>
        {link.children.length > 0 && (
          <ul class="mobile-submenu" role="list">
            {link.children.map((child) => (
              <li><a href={child.url} aria-current={ariaCurrent(child)}>{child.label}</a></li>
            ))}
          </ul>
        )}
      </>
    ))}
  </nav>
  <div class="mobile-menu-section">
    <SearchForm id="menu-q" label="Search the blog" compact />
    <fieldset class="appearance">
      <legend class="section-title">Appearance</legend>
      <ThemeSwitch variant="segmented" />
    </fieldset>
  </div>
</dialog>
