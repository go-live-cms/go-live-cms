---
/**
 * Example Theme - Default Page Layout
 */
import BlockRenderer from '@/components/BlockRenderer'
import SeoHead from '@/components/SeoHead.astro'
import type { SeoMeta } from '@/lib/seo'

interface Props {
  post: any;
  title: string;
  description: string;
  seo?: SeoMeta;
}

const { post, title, description, seo = {} } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title={title} description={description} {...seo} />
    
    <!-- Theme Assets (registered in theme.config.ts) -->
    {Astro.locals.themeAssets?.styles?.map((style: any) => (
      <link rel="stylesheet" href={style.src} media={style.media || 'all'} />
    ))}
  </head>
  <body>
    <header class="example-header">
      <nav>
        <h1>{Astro.locals.themeName || 'Example Theme'}</h1>
        {Astro.locals.themeMenu && (
          <ul>
            {Astro.locals.themeMenu.items.map((item: any) => (
              <li><a href={item.url}>{item.label}</a></li>
            ))}
          </ul>
        )}
      </nav>
    </header>

    <main class="example-page">
      <article>
        <header>
          <h1>{post.title}</h1>
        </header>

        <div class="page-content">
          {post.published_blocks ? (
            <BlockRenderer doc={post.published_blocks} client:load />
          ) : (
            <p>No content available</p>
          )}
        </div>
      </article>
    </main>

    <footer class="example-footer">
      <p>
        Powered by {Astro.locals.themeName} v{Astro.locals.themeVersion}
      </p>
    </footer>

    <!-- Theme Scripts -->
    {Astro.locals.themeAssets?.scripts?.map((script: any) => (
      <script 
        src={script.src} 
        defer={script.defer} 
        async={script.async} 
        type={script.type || 'text/javascript'}
      ></script>
    ))}
  </body>
</html>
