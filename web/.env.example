# Browser-facing API URL. Only the admin CSP reads it (connect-src/img-src); the browser
# itself calls /api/v1 same-origin. Leave unset in production (docs/operations/deploy.md).
PUBLIC_API_URL=http://localhost:8080/api/v1
# API base for server-side (SSR) fetches, read at runtime.
SERVER_API_URL=http://api:8080/api/v1
# Public origin of the site, used for canonical/OG URLs, robots.txt and sitemap.xml.
# Unset: the request's own origin (fine in dev, wrong behind a proxy).
SITE_URL=http://localhost:4321
