{
  "_comment": "Reader comments' discussion state (#522, docs/design/reader-comments.md 12.4). Run by api/discussion_test.go (discussionSetting, discussionState) and web/src/lib/discussion.test.ts (the TypeScript twin). `setting` is the clock-free half a cached /public answer carries; `state` applies `now` to it. Times compare as instants.",
  "cases": [
    {
      "name": "the default on a post type with comments, no timer: open",
      "site": { "comments_enabled": true, "comments_close_after_days": 0 },
      "type": { "public": true, "supports": ["title", "content", "comments"] },
      "post": { "discussion": "default", "first_published_at": "2026-01-01T00:00:00Z" },
      "now": "2030-01-01T00:00:00Z",
      "setting": { "state": "open", "closes_at": null },
      "state": "open"
    },
    {
      "name": "the site switch off beats an explicit Open",
      "site": { "comments_enabled": false, "comments_close_after_days": 0 },
      "type": { "public": true, "supports": ["comments"] },
      "post": { "discussion": "open", "first_published_at": "2026-01-01T00:00:00Z" },
      "now": "2026-01-02T00:00:00Z",
      "setting": { "state": "off", "closes_at": null },
      "state": "off"
    },
    {
      "name": "the site switch off beats an explicit Closed",
