{
  "_comment": "Reader comments' text rules (#522, docs/design/reader-comments.md 6.3, 3.5). Validated once, in Go (api/discussion_text.go); the form's counter uses the same limits and counting (web/src/lib/discussion.ts). Both suites run every case. An input given as `repeat` is `repeat.text` repeated `repeat.times` times. A case has `normalized` (what is stored) or `code` (the 400).",
  "limits": { "body_min": 2, "body_max": 4000, "max_blank_lines": 2, "name_max": 60 },
  "body": [
    { "name": "plain text", "input": "Nice post!", "normalized": "Nice post!" },
    { "name": "CR LF becomes LF", "input": "Line one\r\nLine two", "normalized": "Line one\nLine two" },
    { "name": "a lone CR becomes LF", "input": "one\rtwo", "normalized": "one\ntwo" },
    { "name": "spaces and tabs ending a line go", "input": "one  \ntwo\t \nthree", "normalized": "one\ntwo\nthree" },
    { "name": "the whole is trimmed", "input": "  \n\n  hello there \n\n ", "normalized": "hello there" },
    { "name": "indentation inside is kept", "input": "first\n  second", "normalized": "first\n  second" },
    { "name": "a tab inside is kept", "input": "a\tb", "normalized": "a\tb" },
    { "name": "two blank lines in a row are kept", "input": "a\n\n\nb", "normalized": "a\n\n\nb" },
    { "name": "more blank lines are cut to two", "input": "a\n\n\n\n\n\nb", "normalized": "a\n\n\nb" },
    { "name": "lines of spaces and tabs are blank lines", "input": "a\n \n\t\n  \n \nb", "normalized": "a\n\n\nb" },
    { "name": "CR LF blank lines are cut too", "input": "a\r\n\r\n\r\n\r\nb", "normalized": "a\n\n\nb" },
    { "name": "two characters are enough", "input": "ok", "normalized": "ok" },
    { "name": "one character is too short", "input": "a", "code": "body_too_short" },
    { "name": "one character with spaces around is too short", "input": "   a   ", "code": "body_too_short" },
    { "name": "empty", "input": "", "code": "body_too_short" },
    { "name": "only whitespace", "input": " \n\t\n ", "code": "body_too_short" },
    { "name": "4000 characters", "repeat": { "text": "x", "times": 4000 }, "normalized_repeat": { "text": "x", "times": 4000 } },
    { "name": "4001 characters", "repeat": { "text": "x", "times": 4001 }, "code": "body_too_long" },
    { "name": "characters are code points, not bytes or UTF-16 units", "repeat": { "text": "😀", "times": 4000 }, "normalized_repeat": { "text": "😀", "times": 4000 } },
    { "name": "4001 emoji", "repeat": { "text": "😀", "times": 4001 }, "code": "body_too_long" },
    { "name": "a joined emoji counts each code point", "input": "👩‍💻", "normalized": "👩‍💻" },
    { "name": "NUL is refused", "input": "a\u0000b", "code": "body_invalid" },
    { "name": "a vertical tab is refused", "input": "a\u000bb", "code": "body_invalid" },
    { "name": "a form feed is refused", "input": "a\u000cb", "code": "body_invalid" },
    { "name": "DEL is refused", "input": "ab\u007f", "code": "body_invalid" },
    { "name": "a C1 control is refused", "input": "ab\u0085", "code": "body_invalid" },
    { "name": "a bidi override is refused", "input": "abc‮def", "code": "body_invalid" },
    { "name": "a bidi embedding is refused", "input": "abc‪def", "code": "body_invalid" },
    { "name": "a bidi isolate is refused", "input": "ab⁦cd⁩", "code": "body_invalid" },
    { "name": "a left-to-right mark is allowed", "input": "a‎b", "normalized": "a‎b" },
    { "name": "no-break spaces around are trimmed", "input": " hi ", "normalized": "hi" },
    { "name": "a line separator at the end is trimmed", "input": "hi ", "normalized": "hi" },
    { "name": "a byte order mark is not whitespace", "input": "﻿hi", "normalized": "﻿hi" },
    { "name": "markup is text", "input": "<b>bold</b> & <script>x</script>", "normalized": "<b>bold</b> & <script>x</script>" }
  ],
  "name": [
    { "name": "a name", "input": "Ana Costa", "normalized": "Ana Costa" },
    { "name": "trimmed", "input": "  Ana  ", "normalized": "Ana" },
    { "name": "one character", "input": "A", "normalized": "A" },
    { "name": "empty", "input": "", "code": "name_required" },
    { "name": "only spaces", "input": "   ", "code": "name_required" },
    { "name": "60 characters", "repeat": { "text": "n", "times": 60 }, "normalized_repeat": { "text": "n", "times": 60 } },
    { "name": "61 characters", "repeat": { "text": "n", "times": 61 }, "code": "name_too_long" },
    { "name": "60 emoji", "repeat": { "text": "😀", "times": 60 }, "normalized_repeat": { "text": "😀", "times": 60 } },
    { "name": "a line break is refused", "input": "Ana\nCosta", "code": "name_invalid" },
    { "name": "a tab is refused", "input": "Ana\tCosta", "code": "name_invalid" },
    { "name": "a trailing line break is refused, not trimmed", "input": "Ana\n", "code": "name_invalid" },
    { "name": "a bidi override is refused", "input": "Ana‮Costa", "code": "name_invalid" },
    { "name": "accents are kept", "input": "João Ñúñez", "normalized": "João Ñúñez" }
  ]
}
