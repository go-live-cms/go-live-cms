---
/**
 * A public post type's list, e.g. /post (#345), rendered by the active theme's
 * layouts/archive layout (the default theme's when it has none).
 */
import { getPostTypes } from '../../lib/api'
import { loadPostList, pageNumber } from '../../lib/postList'
import { loadThemeLayout, themeLayoutCandidates } from '../../lib/themeLayout'
import { resolveSiteUrl } from '../../lib/seo'

export const prerender = false

const archiveLayouts = import.meta.glob('../../../themes/*/layouts/archive/*.astro')

const { post_type: postType } = Astro.params as { post_type: string }

// Every unknown single-segment URL (/foo) lands on this route, so it must 404
// unless the segment is a public post type. If the type list can't be
// fetched, fall through and let the posts query decide.
// (Same rule as getPublicPostTypeNames; one request also gives the label.)
let label: string | undefined
try {
  const type = (await getPostTypes()).find((t) => t.name === postType)
  if (!type || type.is_active === false || type.public === false) {
    return new Response(null, { status: 404 })
  }
  label = type.label
} catch (error) {
  console.warn('Could not fetch post types:', error)
}
const heading = label || (postType === 'page' ? 'Pages' : `${postType.charAt(0).toUpperCase()}${postType.slice(1)}s`)

const page = pageNumber(Astro.url.searchParams.get('page'))
const list = await loadPostList(postType, page, `/${postType}`, resolveSiteUrl(Astro.url))
if (page > 1 && list.posts.length === 0) {
  return new Response(null, { status: 404 })
}

const themeSlug = Astro.locals.activeTheme || 'default'
const Layout = await loadThemeLayout(archiveLayouts, themeLayoutCandidates('../../../themes', themeSlug, 'archive'))
if (!Layout) {
  throw new Error('No archive layout in this build')
}
const title = `${heading}${page > 1 ? ` · Page ${page}` : ''} | ${list.siteTitle}`
---

<Layout
  title={title}
  description={`Everything published in ${heading} on ${list.siteTitle}`}
  heading={heading}
  postType={postType}
  list={list}
/>
