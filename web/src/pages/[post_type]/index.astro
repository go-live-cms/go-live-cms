---
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/layouts/Header.astro'
import Footer from '@/layouts/Footer.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import TipTapContent from '@/components/TipTapContent.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts'
import { getPostsByType, getPostTypes, getPublicPostTypeNames } from '../../lib/api'

export async function getStaticPaths() {
  // Dynamically fetch active post types from the API
  let postTypes = ['post', 'page'] // fallback
  try {
    const types = await getPostTypes()
    if (types && types.length > 0) {
      postTypes = types.map(t => t.name)
      console.log('Discovered post types for listing:', postTypes)
    }
  } catch (error) {
    console.warn('Could not fetch post types, using defaults:', error)
  }
  
  const paths: Array<{
    params: { post_type: string }
    props: { postType: string; totalPosts: number | undefined }
  }> = []
  
  for (const postType of postTypes) {
    try {
      const { data: posts, meta } = await getPostsByType(postType, { 
        status: 'published',
        limit: 1 
      })
      
      if (posts.length > 0) {
        paths.push({
          params: { 'post_type': postType },
          props: { postType, totalPosts: meta.total }
        })
      }
    } catch (error) {
      console.warn(`No posts found for type: ${postType}`)
    }
  }
  
  return paths
}

const { 'post_type': postType } = Astro.params as { post_type: string }
const { totalPosts } = Astro.props as { postType: string; totalPosts: number | undefined }

// Every unknown single-segment URL (/foo) lands on this route, so it must 404
// unless the segment is a public post type. If the type list can't be
// fetched, fall through and let the posts query decide.
let publicTypes: string[] | null = null
try {
  publicTypes = await getPublicPostTypeNames()
} catch (error) {
  console.warn('Could not fetch post types:', error)
}
if (publicTypes && !publicTypes.includes(postType)) {
  return new Response(null, { status: 404 })
}

const { data: posts, meta } = await getPostsByType(postType, {
  status: 'published',
  sort: 'date_desc',
  limit: 20
})

const displayType = postType.charAt(0).toUpperCase() + postType.slice(1)
const pluralType = postType === 'page' ? 'Pages' : `${displayType}s`
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead 
      title={`${pluralType} | ${SITE_TITLE}`} 
      description={`Browse all ${pluralType.toLowerCase()} on ${SITE_TITLE}`} 
    />
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h1>{pluralType}</h1>
        {posts.length > 0 && (
          <p>Showing {posts.length} of {meta.total} {pluralType.toLowerCase()}</p>
        )}

        {posts.length === 0 ? (
          <div class="empty-state">
            <h2>No {pluralType.toLowerCase()} yet</h2>
            <p>Nothing has been published here so far. Check back soon.</p>
            <a href="/">Go to the homepage</a>
          </div>
        ) : (
          <ul>
            {posts.map((post: any) => (
              <li>
                <a href={`/${postType}/${post.id}`}>
                  {post.featured_image && (
                    <img src={post.featured_image} alt={post.title} />
                  )}
                  <h4 class="title">{post.title}</h4>
                  <p class="date">
                    <FormattedDate date={new Date(post.created_at)} />
                  </p>
                  {post.description && (
                    <TipTapContent content={post.description} class="excerpt" />
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
        
        {meta.total > posts.length && (
          <div class="pagination">
            <a href={`/${postType}/?page=2`}>Load More</a>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>