---
import { getPublishedPosts, getPublicPost, getSettings, getActiveTheme, getPostTypes, getPublicPostTypeNames } from '../../lib/api'
import { getPostLayoutVariant } from '../../lib/theme-loader'
import { loadThemeLayout, postLayoutCandidates } from '../../lib/themeLayout'
import { parsePageSegment, resolveListRequest } from '../../lib/pagination'
import { metaDescription, normalizeUrlStructure, postLastmod, postPath, publicImageUrl, resolveSiteUrl, toW3cDate, type SeoMeta } from '../../lib/seo'
import { getPostAuthors } from '../../lib/authorPage'
import { getSiteSettings } from '../../lib/siteSettings'
import { getCachedTaxonomyTypes, isTermRoute, linkTerms, termPath, TERM_ARCHIVE_ROUTE } from '../../lib/termPage'
import type { AuthorProfile, Post, TaxonomyTerm, TaxonomyType } from '@gl-admin/lib/api/types'
import { log } from '../../lib/log'

// WordPress-style: Auto-discover all theme layouts using glob imports
// This allows dropping in new themes without modifying code
const allLayouts = import.meta.glob('../../../themes/*/layouts/**/*.astro')

// Disable static pre-rendering to allow dynamic theme loading
export const prerender = false

export async function getStaticPaths() {
  // Dynamically fetch active post types from the API
  let postTypes = ['post', 'page'] // fallback
  try {
    const types = await getPostTypes()
    if (types && types.length > 0) {
      postTypes = types.map(t => t.name)
    }
  } catch (error) {
    log.warn('post_types_fetch_failed', { fallback: postTypes, error })
  }

  // Fetch settings to determine URL structure
  let urlStructure = 'id' // default
  try {
    const settings = await getSettings()
    urlStructure = settings.post_url_structure || 'id'
  } catch (error) {
    log.warn('settings_fetch_failed', { fallback: 'id urls', error })
  }
  
  const paths: Array<{
    params: { 'post_type': string; id: string }
    props: { post: Post; postType: string }
  }> = []
  
  for (const postType of postTypes) {
    try {
      const { data: posts } = await getPublishedPosts(postType)
      
      posts.forEach((post: Post) => {
        // Generate path based on URL structure setting
        const pathId = urlStructure === 'slug' && post.slug ? post.slug : post.id.toString()
        
        paths.push({
          params: { 
            'post_type': postType,
            id: pathId
          },
          props: { post, postType }
        })
      })
    } catch (error) {
      log.warn('posts_by_type_fetch_failed', { post_type: postType, error })
    }
  }

  log.debug('static_paths_generated', { count: paths.length, url_structure: urlStructure })
  return paths
}

const { 'post_type': postType, id } = Astro.params as { 'post_type': string; id: string }
const { post } = Astro.props as { post?: Post }

// Inactive and non-public post types have no public pages. If the type list
// can't be fetched, fall through to the post lookup.
let publicTypes: string[] | null = null
try {
  publicTypes = await getPublicPostTypeNames()
} catch (error) {
  log.warn('post_types_fetch_failed', { error })
}
const typeIsPublic = !publicTypes || publicTypes.includes(postType)

// /page/N/ is also page N of the front page (#349). Pages keep their URLs: a published
// page with id N wins, and only otherwise is it the front page's (rendered by
// src/pages/index.astro, with the page number in Astro.locals). Before the type check,
// so the front page pages even with the page type switched off. Only a 404 means "no
// such page": an API error must not turn a real page's URL into a list (it throws, 500).
if (postType === 'page' && parsePageSegment(id) !== null) {
  // /public answers only for a published post (#393: never the admin's /api/v1/posts).
  const existing = typeIsPublic ? (await getPublicPost(id))?.post : null
  if (existing?.post_type !== 'page') {
    const request = resolveListRequest(Astro.url, '/', id)
    // Temporary: whether /page/N is a page can change when one is published.
    if (request.kind === 'redirect') return Astro.redirect(request.location, 302)
    if (request.kind === 'notFound') return new Response(null, { status: 404 })
    Astro.locals.listPageNumber = request.page
    return Astro.rewrite('/')
  }
}
// Term archives (#348): /{taxonomy}/{slug} when no public post type has the name and a
// public taxonomy does (lib/termPage.ts). Rendered by src/pages/term.archive.astro, with
// the term in Astro.locals; page N is [id]/page/[n].astro.
if (await isTermRoute(postType, publicTypes)) {
  const request = resolveListRequest(Astro.url, termPath(postType, id))
  if (request.kind === 'redirect') return Astro.redirect(request.location, 301)
  if (request.kind === 'notFound') return new Response(null, { status: 404 })
  Astro.locals.termArchive = { taxonomy: postType, slug: id }
  Astro.locals.listPageNumber = request.page
  return Astro.rewrite(TERM_ARCHIVE_ROUTE)
}
if (!typeIsPublic) {
  return new Response(null, { status: 404 })
}

// The post as the site shows it (#358): its published title, excerpt, featured image and
// terms, never the working ones an editor is changing. The API answers only for a
// published post; anything else is a 404 here.
let fullPost: Post | undefined = post
let publishedImage: string | null = null
let publishedTerms: TaxonomyTerm[] = []

// Determine if ID is numeric (ID-based) or not (slug-based)
const isNumeric = /^\d+$/.test(id)

// The page is server-rendered, so there are no props: this fetch is the normal path.
if (!fullPost) {
  try {
    const published = await getPublicPost(id)
    fullPost = published?.post
    publishedImage = published?.featured_image?.url ?? null
    publishedTerms = published?.taxonomy_terms ?? []
  } catch (error) {
    // An unknown id or slug (crawlers, old links) is an ordinary 404, not an error.
    // No id: it is the raw URL segment (api/CLAUDE.md, never log raw paths).
    if ((error as { status?: number })?.status !== 404) {
      log.error('post_fetch_failed', { post_type: postType, by: isNumeric ? 'id' : 'slug', error })
    }
  }
  if (!fullPost) {
    return new Response(null, {
      status: 404,
      statusText: 'Post Not Found'
    })
  }
}

if (!fullPost || !fullPost.title) {
  log.error('post_data_invalid', { post_type: postType, post_id: fullPost?.id })
  return new Response(null, {
    status: 404,
    statusText: 'Post Content Not Found'
  })
}

// Only published posts are public (the public endpoint already refuses the rest; this
// also covers props from getStaticPaths). A post requested under another type's URL
// (/page/12 for a post) is a 404 too. A null-body 404 renders src/pages/404.astro.
if (fullPost.post_status !== 'published' || (fullPost.post_type && fullPost.post_type !== postType)) {
  return new Response(null, { status: 404 })
}

// Phase 2: Apply theme content filter if available
if (Astro.locals.themeFunctions?.filterContent && (fullPost as any).content) {
  try {
    const filtered = await Astro.locals.themeFunctions.filterContent(
      (fullPost as any).content,
      fullPost,
      Astro.locals.themeContext!
    )
    if (filtered && typeof filtered === 'string') {
      (fullPost as any).content = filtered
    }
  } catch (error) {
    log.error('theme_function_failed', { function: 'filterContent', post_id: fullPost.id, error })
    // Continue with unfiltered content
  }
}

// Categories/tags (#167): the published ones, from the post fetch above (#358). Layouts
// that don't take `terms` ignore them. Terms of public taxonomies carry their archive's
// `href` (#348); without the taxonomy list they render unlinked. The byline and "Written
// by" cards (#350) come with them: credited authors with their bios. A failed lookup
// renders the post with its owner in the byline and no cards.
const [taxonomyTypes, authors] = await Promise.all([
  getCachedTaxonomyTypes().catch((error): TaxonomyType[] => {
    log.warn('taxonomy_types_fetch_failed', { error })
    return []
  }),
  getPostAuthors(fullPost.id).catch((error): AuthorProfile[] => {
    log.warn('post_authors_fetch_failed', { post_id: fullPost.id, error })
    return []
  }),
])
const terms = linkTerms(publishedTerms, taxonomyTypes)

// Get layout variant for this post
const layoutVariant = await getPostLayoutVariant(fullPost, postType)

// Get active theme for dynamic layout loading
const activeTheme = await getActiveTheme()
const themeSlug = activeTheme.slug

// Layout fallback chain (lib/themeLayout.ts): the type's own layouts/{postType}/{variant}
// (never home/archive/error, which hold page layouts), the theme's layouts/post ones, then
// the default theme's.
const LayoutComponent = await loadThemeLayout(
  allLayouts,
  postLayoutCandidates("../../../themes", themeSlug, postType, layoutVariant),
)

if (!LayoutComponent) {
  log.error('post_layout_not_found', { theme: themeSlug, post_type: postType, variant: layoutVariant })
  return new Response(null, {
    status: 500,
    statusText: 'Layout Not Found'
  })
}

// SEO (#137): the canonical URL follows the site's id/slug setting, so the
// same post reached by id and by slug points crawlers at one URL.
// The same per-request lookup the layout, SeoHead and bylines use (#330); it never
// rejects (defaults when the API is down).
const site = await getSiteSettings(Astro.locals)
// The published featured image (#358); a getStaticPaths prop may carry its own.
const featuredImage = fullPost.featured_image || publishedImage
const urlStructure = normalizeUrlStructure(site.urlStructure)

const displayType = postType.charAt(0).toUpperCase() + postType.slice(1)
const title = `${fullPost.title} | ${displayType}`
const description = metaDescription(fullPost.description) || `Read ${fullPost.title}`
const seo: SeoMeta = {
  canonical: postPath({ ...fullPost, post_type: postType }, urlStructure),
  image: featuredImage,
  type: 'article',
  siteName: site.title,
  publishedTime: toW3cDate(fullPost.created_at),
  modifiedTime: postLastmod(fullPost),
}
---

<LayoutComponent
  post={fullPost}
  title={title}
  description={description}
  seo={seo}
  terms={terms}
  authors={authors}
  featuredImage={publicImageUrl(resolveSiteUrl(Astro.url), featuredImage) ?? null}
  siteTitle={site.title}
  urlStructure={urlStructure}
/>