---
import { getPostsByType, getPostById, findPostById, getPostBySlug, getSettings, getActiveTheme, getPostTypes, getPublicPostTypeNames, getFeaturedImageUrl, getPostTaxonomyTerms } from '../../lib/api'
import { getPostLayoutVariant } from '../../lib/theme-loader'
import { loadThemeLayout, postLayoutCandidates } from '../../lib/themeLayout'
import { parsePageSegment, resolveListRequest } from '../../lib/pagination'
import { metaDescription, normalizeUrlStructure, postLastmod, postPath, publicImageUrl, resolveSiteUrl, toW3cDate, type SeoMeta } from '../../lib/seo'
import { getPostAuthors } from '../../lib/authorPage'
import { SITE_TITLE } from '../../consts'
import type { AuthorProfile, Post, TaxonomyTerm } from '@gl-admin/lib/api/types'

// WordPress-style: Auto-discover all theme layouts using glob imports
// This allows dropping in new themes without modifying code
const allLayouts = import.meta.glob('../../../themes/*/layouts/**/*.astro')

// Disable static pre-rendering to allow dynamic theme loading
export const prerender = false

export async function getStaticPaths() {
  // Dynamically fetch active post types from the API
  let postTypes = ['post', 'page'] // fallback
  try {
    const types = await getPostTypes()
    if (types && types.length > 0) {
      postTypes = types.map(t => t.name)
      console.log('Discovered post types:', postTypes)
    }
  } catch (error) {
    console.warn('Could not fetch post types, using defaults:', error)
  }
  
  // Fetch settings to determine URL structure
  let urlStructure = 'id' // default
  try {
    const settings = await getSettings()
    urlStructure = settings.post_url_structure || 'id'
    console.log('Using URL structure:', urlStructure)
  } catch (error) {
    console.warn('Could not fetch settings, using ID-based URLs:', error)
  }
  
  const paths: Array<{
    params: { 'post_type': string; id: string }
    props: { post: Post; postType: string }
  }> = []
  
  for (const postType of postTypes) {
    try {
      const { data: posts } = await getPostsByType(postType, { 
        status: 'published'
      })
      
      posts.forEach((post: Post) => {
        // Generate path based on URL structure setting
        const pathId = urlStructure === 'slug' && post.slug ? post.slug : post.id.toString()
        
        paths.push({
          params: { 
            'post_type': postType,
            id: pathId
          },
          props: { post, postType }
        })
      })
    } catch (error) {
      console.warn(`Error fetching posts for type: ${postType}`, error)
    }
  }
  
  console.log(`Generated ${paths.length} paths with structure: ${urlStructure}`)
  return paths
}

const { 'post_type': postType, id } = Astro.params as { 'post_type': string; id: string }
const { post } = Astro.props as { post?: Post }

console.log(`Rendering ${postType} with ID/slug:`, id)

// Inactive and non-public post types have no public pages. If the type list
// can't be fetched, fall through to the post lookup.
let publicTypes: string[] | null = null
try {
  publicTypes = await getPublicPostTypeNames()
} catch (error) {
  console.warn('Could not fetch post types:', error)
}
const typeIsPublic = !publicTypes || publicTypes.includes(postType)

// /page/N/ is also page N of the front page (#349). Pages keep their URLs: a published
// page with id N wins, and only otherwise is it the front page's (rendered by
// src/pages/index.astro, with the page number in Astro.locals). Before the type check,
// so the front page pages even with the page type switched off. Only a 404 means "no
// such page": an API error must not turn a real page's URL into a list (it throws, 500).
let pagePost: Post | undefined
if (postType === 'page' && parsePageSegment(id) !== null) {
  const existing = typeIsPublic ? await findPostById(id) : null
  if (existing?.post_status === 'published' && existing.post_type === 'page') {
    pagePost = existing
  } else {
    const request = resolveListRequest(Astro.url, '/', id)
    // Temporary: whether /page/N is a page can change when one is published.
    if (request.kind === 'redirect') return Astro.redirect(request.location, 302)
    if (request.kind === 'notFound') return new Response(null, { status: 404 })
    Astro.locals.listPageNumber = request.page
    return Astro.rewrite('/')
  }
}
if (!typeIsPublic) {
  return new Response(null, { status: 404 })
}

// A page found above is already fresh: don't fetch it again.
let fullPost: Post | undefined = post ?? pagePost

// Determine if ID is numeric (ID-based) or not (slug-based)
const isNumeric = /^\d+$/.test(id)

if (!fullPost) {
  console.error(`Post not found in props for ${postType} ID/slug:`, id)
  
  try {
    console.log(`Attempting to fetch ${postType} directly for ID/slug:`, id)
    let postResponse
    if (isNumeric) {
      postResponse = await getPostById(id)
    } else {
      postResponse = await getPostBySlug(id)
    }
    
    if (postResponse && postResponse.post) {
      console.log('Found post via direct fetch:', postResponse.post.title)
      fullPost = postResponse.post
    } else {
      console.error(`Post not found via direct fetch for ${postType} ID/slug:`, id)
      return new Response(null, {
        status: 404,
        statusText: 'Post Not Found'
      })
    }
  } catch (error) {
    console.error(`Error fetching ${postType} directly for ID/slug:`, id, 'Error:', error)
    return new Response(null, {
      status: 404,
      statusText: 'Post Not Found'
    })
  }
}

if (post) {
  try {
    console.log(`Fetching fresh ${postType} data for ID/slug:`, id)
    let postResponse
    if (isNumeric) {
      postResponse = await getPostById(id)
    } else {
      postResponse = await getPostBySlug(id)
    }
    
    if (postResponse && postResponse.post) {
      fullPost = postResponse.post
      console.log(`Successfully fetched fresh ${postType} data:`, fullPost?.title)
    }
  } catch (error) {
    console.warn(`Could not fetch fresh ${postType} data for ID/slug:`, id, 'Error:', error.message)
    fullPost = post
  }
}

if (!fullPost) {
  try {
    console.log(`Final attempt to fetch ${postType} for ID/slug:`, id)
    let postResponse
    if (isNumeric) {
      postResponse = await getPostById(id)
    } else {
      postResponse = await getPostBySlug(id)
    }
    fullPost = postResponse.post
  } catch (error) {
    console.error(`Final fetch attempt failed for ${postType} ID/slug:`, id)
    return new Response(null, {
      status: 404,
      statusText: 'Post Not Found'
    })
  }
}

if (!fullPost || !fullPost.title) {
  console.error(`Full ${postType} data is invalid for ID:`, id)
  return new Response(null, {
    status: 404,
    statusText: 'Post Content Not Found'
  })
}

// The API returns drafts (including unpublished posts, #136) and archived posts
// by id/slug to anyone, so only published posts are public here. A post
// requested under another type's URL (/page/12 for a post) is a 404 too. A
// null-body 404 renders src/pages/404.astro.
if (fullPost.post_status !== 'published' || (fullPost.post_type && fullPost.post_type !== postType)) {
  return new Response(null, { status: 404 })
}

// Phase 2: Apply theme content filter if available
if (Astro.locals.themeFunctions?.filterContent && (fullPost as any).content) {
  try {
    const filtered = await Astro.locals.themeFunctions.filterContent(
      (fullPost as any).content,
      fullPost,
      Astro.locals.themeContext!
    )
    if (filtered && typeof filtered === 'string') {
      (fullPost as any).content = filtered
    }
  } catch (error) {
    console.error('[Theme] Error in filterContent:', error)
    // Continue with unfiltered content
  }
}

// Categories/tags (#167). Layouts that don't take `terms` ignore them; a failed
// lookup just renders the post without them. The byline and "Written by" cards (#350) come with them: credited authors with their
// bios. A failed lookup renders the post with its owner in the byline and no cards.
const [terms, authors] = await Promise.all([
  getPostTaxonomyTerms(fullPost.id).catch((error): TaxonomyTerm[] => {
    console.warn(`Could not fetch terms for ${postType} ${fullPost.id}:`, error)
    return []
  }),
  getPostAuthors(fullPost.id).catch((error): AuthorProfile[] => {
    console.warn(`Could not fetch authors for ${postType} ${fullPost.id}:`, error)
    return []
  }),
])

// Get layout variant for this post
const layoutVariant = await getPostLayoutVariant(fullPost, postType)

// Get active theme for dynamic layout loading
const activeTheme = await getActiveTheme()
const themeSlug = activeTheme.slug
console.log(`🎨 Active theme: ${activeTheme.name} (${themeSlug}), layout variant: ${layoutVariant}`)

// Layout fallback chain (lib/themeLayout.ts): the type's own layouts/{postType}/{variant}
// (never home/archive/error, which hold page layouts), the theme's layouts/post ones, then
// the default theme's.
const LayoutComponent = await loadThemeLayout(
  allLayouts,
  postLayoutCandidates("../../../themes", themeSlug, postType, layoutVariant),
)

if (!LayoutComponent) {
  console.error(`No layout found for ${postType}/${layoutVariant} in any fallback`)
  return new Response(null, {
    status: 500,
    statusText: 'Layout Not Found'
  })
}

// SEO (#137): the canonical URL follows the site's id/slug setting, so the
// same post reached by id and by slug points crawlers at one URL.
const [settings, featuredImage] = await Promise.all([
  getSettings().catch((error) => {
    console.warn('Could not fetch settings for SEO tags:', error)
    return null
  }),
  fullPost.featured_image
    ? Promise.resolve(fullPost.featured_image)
    : getFeaturedImageUrl(fullPost.id).catch(() => null),
])
const urlStructure = normalizeUrlStructure(settings?.post_url_structure)

const displayType = postType.charAt(0).toUpperCase() + postType.slice(1)
const title = `${fullPost.title} | ${displayType}`
const description = metaDescription(fullPost.description) || `Read ${fullPost.title}`
const seo: SeoMeta = {
  canonical: postPath({ ...fullPost, post_type: postType }, urlStructure),
  image: featuredImage,
  type: 'article',
  siteName: settings?.site_title || SITE_TITLE,
  publishedTime: toW3cDate(fullPost.created_at),
  modifiedTime: postLastmod(fullPost),
}
---

<LayoutComponent
  post={fullPost}
  title={title}
  description={description}
  seo={seo}
  terms={terms}
  authors={authors}
  featuredImage={publicImageUrl(resolveSiteUrl(Astro.url), featuredImage) ?? null}
  siteTitle={settings?.site_title || SITE_TITLE}
/>