---
import Admin from "@/layouts/gl-admin/Layout.astro"
import MediaCard from "@gl-admin/components/media/MediaCard.astro"
import "@gl-admin/assets/styles/pages/media-page.scss"
import { api, getMediaURL } from "@gl-admin/lib/api"
import type { Media } from "@gl-admin/lib/types"
import GLAdminButton from "@gl-admin/components/ui/Button"
import Icon from "@/components/Icon.astro"

let mediaItems: Media[] = []
let error: string | null = null
let total = 0

try {
  const response = await api.getMedia()
  mediaItems = response.data
  total = response.meta.total
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to fetch media"
  console.error("Error fetching media:", e)
}

function getFileIcon(mediaPath: string): string {
  const ext = mediaPath.split(".").pop()?.toLowerCase()
  if (["jpg", "jpeg", "png", "gif", "webp", "bmp", "svg"].includes(ext || "")) return "🖼️"
  if (["mp4", "mov", "avi", "mkv", "webm"].includes(ext || "")) return "🎥"
  if (["mp3", "wav", "ogg", "m4a"].includes(ext || "")) return "🎵"
  if (["pdf"].includes(ext || "")) return "📄"
  if (["doc", "docx"].includes(ext || "")) return "📝"
  return "📁"
}

function isImage(mediaPath: string): boolean {
  const ext = mediaPath.split(".").pop()?.toLowerCase()
  return ["jpg", "jpeg", "png", "gif", "webp", "bmp"].includes(ext || "")
}
---

<Admin title="Media Library" description="Manage your media files">
  <div class="gl-admin-media-library">
    <!-- Header -->
    <div class="gl-admin-media-header">
      <div class="gl-admin-media-header-left">
        <h1 class="gl-admin-media-header__title">Media Library</h1>
        <!-- adding this later above the load more <p class="gl-admin-media-header__count">{total} {total === 1 ? 'item' : 'items'}</p> -->
      </div>
      <div class="gl-admin-media-header-right">
        <div class="gl-admin-media-header__filters">
          <div class="gl-admin-media-header__filter-wrapper">
            <select class="gl-admin-media-header__filter" id="media-filter-author">
              <option value="">All Authors</option>
              <!-- TODO: Add author options dynamically -->
            </select>
          </div>

          <div class="gl-admin-media-header__filter-wrapper">
            <select class="gl-admin-media-header__filter" id="media-filter-type">
              <option value="">All Types</option>
              <option value="image">Images</option>
              <option value="video">Videos</option>
              <option value="audio">Audio</option>
              <option value="document">Documents</option>
            </select>
          </div>
          <div class="gl-admin-media-header__sort-wrapper">
            <label for="media-sort" class="gl-admin-media-header__sort-label">Sort by:</label>
            <select class="gl-admin-media-header__sort" id="media-sort">
              <option value="date_desc">Last Added</option>
              <option value="date_asc">Oldest First</option>
            </select>
          </div>
        </div>
        <div class="gl-admin-media-header__button-wrapper">
          <GLAdminButton className="gl-admin-media__bulk-select" id="gl-admin-media__bulk-select" variation="flat">
            <Icon name="bulkSelectIcon" color="#333536" width="14" height="14" /> Bulk Select
          </GLAdminButton>
          <GLAdminButton className="gl-admin-media__new-media-btn" id="gl-admin-media__new-media-btn">
            <Icon name="add" color="white" width="14" height="14" /> New Media
          </GLAdminButton>
        </div>
      </div>
    </div>

    <div class="gl-admin-media__upload-area" id="gl-admin-media__upload-area">
      <div class="gl-admin-media__upload-area-header">
        <h3>Drop files to upload</h3>
        <div>
          <span>or</span>
          <div class="gl-admin-media__upload-area-button-wrapper">
            <GLAdminButton className="gl-admin-media__upload-btn" id="gl-admin-media__upload-btn">
              <Icon name="uploadIcon" color="white" width="14" height="14" /> Upload Files
            </GLAdminButton>
            <GLAdminButton
              className="gl-admin-media__cancel-upload-btn"
              id="gl-admin-media__cancel-upload-btn"
              variation="flat"
            >
              Cancel
            </GLAdminButton>
          </div>
        </div>
        <small
          >Maximum size: 50MB. Supported: Images, Videos, Audio, Documents <!-- TODO:import number from env size limit -->
        </small>
      </div>
      <input
        type="file"
        id="file-input"
        multiple
        accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt"
        style="display: none;"
      />
    </div>

    <div class="gl-admin-media__upload-progress" id="upload-progress" style="display: none;">
      <div class="gl-admin-media__progress-item" id="progress-template" style="display: none;">
        <div class="gl-admin-media__progress-info">
          <span class="gl-admin-media__file-name"></span>
          <span class="gl-admin-media__file-size"></span>
        </div>
        <div class="gl-admin-media__progress-bar">
          <div class="gl-admin-media__progress-fill"></div>
        </div>
        <span class="gl-admin-media__progress-status"></span>
      </div>
    </div>

    {
      error && (
        <div class="error-message">
          <strong>Error:</strong> {error}
        </div>
      )
    }

    <div class="gl-admin-media__container" id="media-container">
      <div class="gl-admin-media__grid" id="media-grid">
        {mediaItems.map((media) => <MediaCard media={media} />)}
      </div>

      {
        mediaItems.length === 0 && !error && (
          <div class="empty-state">
            <div class="empty-icon" />
            <h3>No media files yet</h3>
            <p>Upload your first file by clicking "New Media" above</p>
          </div>
        )
      }
    </div>
  </div>

  <div class="modal" id="edit-modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Edit Media</h3>
        <button class="modal-close" id="close-modal">&times;</button>
      </div>
      <form class="modal-body" id="edit-form">
        <input type="hidden" id="edit-id" />

        <div class="form-group">
          <label for="edit-name">Name:</label>
          <input type="text" id="edit-name" name="name" required />
        </div>

        <div class="form-group">
          <label for="edit-description">Description:</label>
          <textarea id="edit-description" name="description" rows="3" required></textarea>
        </div>

        <div class="form-group">
          <label for="edit-alt">Alt Text:</label>
          <input type="text" id="edit-alt" name="alt" required />
        </div>

        <div class="form-actions">
          <button type="button" class="btn btn-secondary" id="cancel-edit">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <script>
    import { api, getMediaURL } from "@gl-admin/lib/api"
    import type { Media } from "@gl-admin/lib/types"

    const newMediaBtn = document.getElementById("gl-admin-media__new-media-btn")!
    const uploadArea = document.getElementById("gl-admin-media__upload-area")!
    const uploadBtn = document.getElementById("gl-admin-media__upload-btn")!
    const cancelUploadBtn = document.getElementById("gl-admin-media__cancel-upload-btn")!
    const fileInput = document.getElementById("file-input")! as HTMLInputElement
    const uploadProgress = document.getElementById("upload-progress")!
    const mediaContainer = document.getElementById("media-container")!
    const progressTemplate = document.getElementById("progress-template")!

    function showUploadArea() {
      mediaContainer.classList.add("gl-admin-media__container--with-upload")
      uploadArea.classList.add("gl-admin-media__upload-area--animating")

      requestAnimationFrame(() => {
        uploadArea.classList.add("gl-admin-media__upload-area--active")

        setTimeout(() => {
          uploadArea.classList.remove("gl-admin-media__upload-area--animating")
          uploadArea.style.height = "auto"
        }, 400)
      })
    }

    function hideUploadArea() {
      const currentHeight = uploadArea.offsetHeight
      uploadArea.style.height = `${currentHeight}px`

      uploadArea.offsetHeight

      uploadArea.classList.add("gl-admin-media__upload-area--animating")
      uploadArea.classList.remove("gl-admin-media__upload-area--active")

      requestAnimationFrame(() => {
        uploadArea.style.height = "0px"
      })
      setTimeout(() => {
        uploadArea.classList.remove("gl-admin-media__upload-area--animating")
        uploadArea.style.height = ""
        mediaContainer.classList.remove("gl-admin-media__container--with-upload")
        fileInput.value = ""
      }, 400)
    }

    newMediaBtn.addEventListener("click", () => {
      showUploadArea()
    })

    cancelUploadBtn.addEventListener("click", () => {
      hideUploadArea()
    })

    uploadBtn.addEventListener("click", () => {
      fileInput.click()
    })

    uploadArea.addEventListener("dragover", (e) => {
      e.preventDefault()
      uploadArea.classList.add("gl-admin-media__upload-area--dragover")
    })

    uploadArea.addEventListener("dragleave", (e) => {
      e.preventDefault()
      const rect = uploadArea.getBoundingClientRect()
      const x = e.clientX
      const y = e.clientY

      if (x < rect.left || x >= rect.right || y < rect.top || y >= rect.bottom) {
        uploadArea.classList.remove("gl-admin-media__upload-area--dragover")
      }
    })

    uploadArea.addEventListener("drop", (e) => {
      e.preventDefault()
      uploadArea.classList.remove("gl-admin-media__upload-area--dragover")

      const files = e.dataTransfer?.files ? Array.from(e.dataTransfer.files) : []
      if (files.length > 0) {
        handleFileUpload(files)
      }
    })

    fileInput.addEventListener("change", (e: Event) => {
      const target = e.target as HTMLInputElement
      if (target && target.files) {
        const files = Array.from(target.files)
        if (files.length > 0) {
          handleFileUpload(files)
        }
      }
    })

    function createProgressItem(file: File): HTMLElement {
      const progressItem = progressTemplate.cloneNode(true) as HTMLElement
      progressItem.style.display = "flex"
      progressItem.id = `progress-${Date.now()}-${Math.random()}`

      const fileName = progressItem.querySelector(".gl-admin-media__file-name")!
      const fileSize = progressItem.querySelector(".gl-admin-media__file-size")!
      const progressFill = progressItem.querySelector(".gl-admin-media__progress-fill")!
      const progressStatus = progressItem.querySelector(".gl-admin-media__progress-status")!

      fileName.textContent = file.name
      fileSize.textContent = formatFileSize(file.size)
      progressStatus.textContent = "Uploading..."

      return progressItem
    }

    async function uploadSingleFile(file: File, progressItem: HTMLElement): Promise<boolean> {
      const progressFill = progressItem.querySelector(".gl-admin-media__progress-fill") as HTMLElement
      const progressStatus = progressItem.querySelector(".gl-admin-media__progress-status") as HTMLElement

      try {
        const formData = new FormData()
        formData.append("file", file)
        formData.append("name", file.name)
        formData.append("description", `Uploaded file: ${file.name}`)
        formData.append("alt", file.name.split(".")[0])

        const result = await api.createMedia(formData)

        let progress = 0
        const progressInterval = setInterval(() => {
          progress += Math.random() * 20
          if (progress > 90) progress = 90
          progressFill.style.width = `${progress}%`
          progressStatus.textContent = `${Math.round(progress)}%`
        }, 100)

        await new Promise((resolve) => setTimeout(resolve, 500))

        clearInterval(progressInterval)
        progressFill.style.width = "100%"
        progressFill.classList.add("gl-admin-media__progress-fill--success")
        progressStatus.textContent = "Complete"
        progressStatus.classList.add("gl-admin-media__progress-status--success")

        return true
      } catch (error) {
        console.error("Upload error:", error)
        progressFill.classList.add("gl-admin-media__progress-fill--error")
        progressStatus.textContent = "Failed"
        progressStatus.classList.add("gl-admin-media__progress-status--error")
        return false
      }
    }

    async function handleFileUpload(files: File[]) {
      uploadProgress.style.display = "block"
      uploadProgress.style.height = "0px"
      uploadProgress.style.opacity = "0"
      uploadProgress.classList.add("gl-admin-media__upload-progress--active")

      requestAnimationFrame(() => {
        uploadProgress.style.height = "auto"
        uploadProgress.style.opacity = "1"
      })

      const existingItems = uploadProgress.querySelectorAll(".gl-admin-media__progress-item:not(#progress-template)")
      existingItems.forEach((item) => item.remove())

      const uploadPromises: Promise<boolean>[] = []

      for (const file of files) {
        const progressItem = createProgressItem(file)
        uploadProgress.appendChild(progressItem)
        uploadPromises.push(uploadSingleFile(file, progressItem))
      }

      try {
        const results = await Promise.allSettled(uploadPromises)
        const successCount = results.filter((result) => result.status === "fulfilled" && result.value).length
        const failCount = results.length - successCount

        setTimeout(() => {
          if (successCount > 0) {
            showToast(
              `Successfully uploaded ${successCount} file${successCount !== 1 ? "s" : ""}${failCount > 0 ? `, ${failCount} failed` : ""}`,
              "success"
            )

            setTimeout(() => {
              window.location.reload()
            }, 1500)
          } else {
            showToast("All uploads failed", "error")
          }

          setTimeout(() => {
            hideUploadArea()

            uploadProgress.style.height = "0px"
            uploadProgress.style.opacity = "0"
            setTimeout(() => {
              uploadProgress.style.display = "none"
            }, 300)
          }, 2000)
        }, 1000)
      } catch (error) {
        console.error("Upload error:", error)
        showToast("Upload failed", "error")

        setTimeout(() => {
          hideUploadArea()
          uploadProgress.style.height = "0px"
          uploadProgress.style.opacity = "0"
          setTimeout(() => {
            uploadProgress.style.display = "none"
          }, 300)
        }, 2000)
      }
    }

    function showToast(message: string, type: "success" | "error" | "info" = "info") {
      const toastContainer = document.getElementById("toast-container")!
      const toast = document.createElement("div")
      toast.className = `toast toast--${type}`
      toast.textContent = message

      toast.style.transform = "translateX(100%)"
      toast.style.opacity = "0"

      toastContainer.appendChild(toast)

      requestAnimationFrame(() => {
        toast.style.transform = "translateX(0)"
        toast.style.opacity = "1"
        toast.style.transition = "transform 0.3s ease, opacity 0.3s ease"
      })

      setTimeout(() => {
        toast.style.transform = "translateX(100%)"
        toast.style.opacity = "0"
        setTimeout(() => {
          toast.remove()
        }, 300)
      }, 4700)
    }

    function formatFileSize(bytes: number): string {
      if (bytes === 0) return "0 B"
      const k = 1024
      const sizes = ["B", "KB", "MB", "GB"]
      const i = Math.floor(Math.log(bytes) / Math.log(k))
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i]
    }
  </script>

  <script>
    import { initializeMediaCardHandlers } from "@gl-admin/scripts/media-card-handlers"
    document.addEventListener("DOMContentLoaded", () => {
      initializeMediaCardHandlers()
    })
  </script>
</Admin>
