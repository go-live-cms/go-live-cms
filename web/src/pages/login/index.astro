---
import Head from "@/layouts/Page/Head.astro"
import Foot from "@/layouts/Page/Foot.astro"
import { SITE_TITLE } from "@/consts"
import GLLogo from "@gl-admin/assets/gl-logo.svg?raw"
import "@gl-admin/assets/styles/pages/login.scss"
---

<Head title={`Sign in - ${SITE_TITLE}`} description="Sign in to the GoLive admin" />

<main class="gl-admin-login">
  <form class="gl-admin-login__card" id="loginForm" novalidate>
    <header class="gl-admin-login__header">
      <span class="gl-admin-login__logo" aria-hidden="true" set:html={GLLogo} />
      <h1 class="gl-admin-login__title">Sign in</h1>
      <p class="gl-admin-login__subtitle">Access the GoLive admin dashboard</p>
    </header>

    <p id="errorMessage" class="gl-admin-login__error" role="alert" hidden></p>

    <div class="gl-admin-login__fields">
      <div class="gl-input">
        <input
          class="gl-input__field"
          type="text"
          id="username"
          name="username"
          placeholder=" "
          required
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
        />
        <label class="gl-input__label" for="username">Username</label>
      </div>

      <div class="gl-input">
        <input
          class="gl-input__field"
          type="password"
          id="password"
          name="password"
          placeholder=" "
          required
          autocomplete="current-password"
        />
        <label class="gl-input__label" for="password">Password</label>
      </div>
    </div>

    <button type="submit" class="button primary gl-admin-login__submit" id="loginButton">
      <span class="gl-admin-login__spinner" id="buttonLoading" aria-hidden="true" hidden></span>
      <span id="buttonText">Sign in</span>
    </button>
  </form>
</main>

<Foot>
  <script>
    import { authManager } from "@gl-admin/lib/auth.ts"

    const form = document.getElementById("loginForm") as HTMLFormElement
    const errorMessage = document.getElementById("errorMessage") as HTMLParagraphElement
    const loginButton = document.getElementById("loginButton") as HTMLButtonElement
    const buttonText = document.getElementById("buttonText") as HTMLSpanElement
    const buttonLoading = document.getElementById("buttonLoading") as HTMLSpanElement
    const inputs = Array.from(form.querySelectorAll<HTMLInputElement>("input"))

    const authState = authManager.getState()
    if (authState.isAuthenticated) {
      const redirectTo = new URLSearchParams(window.location.search).get("redirect") || "/gl-admin"
      window.location.href = redirectTo
    }

    function setInvalid(invalid: boolean) {
      for (const input of inputs) {
        input.closest(".gl-input")?.classList.toggle("is-invalid", invalid)
        if (invalid) {
          input.setAttribute("aria-invalid", "true")
          input.setAttribute("aria-describedby", "errorMessage")
        } else {
          input.removeAttribute("aria-invalid")
          input.removeAttribute("aria-describedby")
        }
      }
    }

    function showError(message: string) {
      errorMessage.textContent = message
      errorMessage.hidden = false
      setInvalid(true)
    }

    function hideError() {
      errorMessage.hidden = true
      errorMessage.textContent = ""
      setInvalid(false)
    }

    // authManager.login surfaces raw API errors ("HTTP 401: {...}"); show people
    // something they can act on instead.
    function friendlyError(error?: string): string {
      if (!error) return "Sign in failed. Please try again."
      if (/\b401\b/.test(error)) return "Incorrect username or password."
      if (/\b429\b/.test(error)) return "Too many sign-in attempts. Wait a moment and try again."
      if (/^HTTP \d{3}/.test(error)) return "Sign in failed. Please try again."
      return error
    }

    function setLoading(loading: boolean) {
      loginButton.disabled = loading
      loginButton.setAttribute("aria-busy", String(loading))
      buttonLoading.hidden = !loading
      buttonText.textContent = loading ? "Signing in…" : "Sign in"
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      hideError()

      const formData = new FormData(form)
      const username = (formData.get("username") as string).trim()
      const password = formData.get("password") as string

      if (!username || !password) {
        showError("Enter your username and password.")
        ;(username ? inputs[1] : inputs[0]).focus()
        return
      }

      setLoading(true)

      try {
        const result = await authManager.login(username, password)

        if (result.success) {
          const redirectTo = new URLSearchParams(window.location.search).get("redirect") || "/gl-admin"
          window.location.href = redirectTo
        } else {
          showError(friendlyError(result.error))
        }
      } catch (error) {
        showError("An unexpected error occurred")
      } finally {
        setLoading(false)
      }
    })
  </script>
</Foot>
