---
import AccountPage from "@/layouts/AccountPage.astro"
import AccountError from "@/components/account/AccountError.astro"
import { SITE_TITLE } from "@/consts"
---

<AccountPage title="Sign in" description="Sign in to the GoLive admin">
  <form class="gl-admin-login__view" id="loginForm" novalidate>
    <header class="gl-admin-login__header">
      <h1 class="gl-admin-login__title">Sign in</h1>
      <p class="gl-admin-login__subtitle">to {SITE_TITLE}</p>
    </header>

    <!-- Why the admin signed this tab out (?reason=, lib/loginPage.ts). -->
    <div id="noticeMessage" class="gl-notice gl-notice--info" role="status" hidden>
      <span class="gl-notice__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
          ><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg
        >
      </span>
      <span class="gl-notice__text" data-notice-text></span>
    </div>
    <AccountError />

    <div class="gl-admin-login__fields">
      <div class="gl-input">
        <label class="gl-input__label" for="username">Username</label>
        <input
          class="gl-input__field"
          type="text"
          id="username"
          name="username"
          required
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
        />
      </div>

      <!-- The link comes after the input so Tab goes username → password;
           CSS puts it on the label row, as in the design. -->
      <div class="gl-input gl-admin-login__with-link">
        <label class="gl-input__label" for="password">Password</label>
        <input
          class="gl-input__field"
          type="password"
          id="password"
          name="password"
          required
          autocomplete="current-password"
        />
        <a class="gl-admin-login__link gl-admin-login__link--small gl-admin-login__field-link" href="/forgot-password">Forgot password?</a>
      </div>
    </div>

    <button type="submit" class="gl-button gl-button--primary gl-admin-login__submit">
      <span class="gl-button__spinner" data-spinner aria-hidden="true" hidden></span>
      <span data-label>Sign in</span>
    </button>
  </form>

  <p class="gl-admin-login__after" slot="after">Don't have an account? Ask an admin to invite you.</p>
</AccountPage>

<script>
  import { authManager } from "@gl-admin/lib/auth"
  import { mountLoginPage } from "@gl-admin/lib/loginPage"

  mountLoginPage(document, authManager)
</script>
