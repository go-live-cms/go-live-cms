---
import AccountPage from "@/layouts/AccountPage.astro"
import AccountError from "@/components/account/AccountError.astro"
---

<AccountPage title="Forgot password" description="Get a link to choose a new password">
  <form class="gl-admin-login__view" id="forgotForm" novalidate>
    <header class="gl-admin-login__header">
      <h1 class="gl-admin-login__title">Forgot your password?</h1>
      <p class="gl-admin-login__subtitle">Enter the email you sign in with and we'll send you a link to set a new one.</p>
    </header>

    <AccountError />

    <div class="gl-input">
      <label class="gl-input__label" for="email">Email</label>
      <input
        class="gl-input__field"
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        autocapitalize="none"
        spellcheck="false"
      />
    </div>

    <button type="submit" class="gl-button gl-button--primary gl-admin-login__submit">
      <span class="gl-button__spinner" data-spinner aria-hidden="true" hidden></span>
      <span data-label>Send reset link</span>
    </button>
  </form>

  <!-- The API answers the same for any address (it never says whether one has
       an account), so this panel does too. -->
  <section class="gl-admin-login__view" id="resetSent" role="status" hidden>
    <span class="gl-admin-login__badge" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
        ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
      >
    </span>
    <header class="gl-admin-login__header">
      <h1 class="gl-admin-login__title" tabindex="-1">Check your email</h1>
      <p class="gl-admin-login__subtitle">
        If <strong class="gl-admin-login__strong" id="sentTo">that address</strong> has an account, a reset link is on its way. It works
        once and expires soon.
      </p>
    </header>
    <p class="gl-admin-login__footnote">
      Nothing after a few minutes? Check spam, or <button type="button" class="gl-admin-login__link gl-admin-login__link--button" id="tryAnotherEmail">try another email</button>.
    </p>
  </section>

  <a class="gl-admin-login__link gl-admin-login__link--small" href="/login" slot="after">Back to sign in</a>
</AccountPage>

<script>
  import { mountForgotPasswordPage } from "@gl-admin/lib/accountPages"

  mountForgotPasswordPage()
</script>
