---
/**
 * POST /gl-comments/posts/:id (#524, docs/design/reader-comments.md 9.4): the comment
 * form's action. Same-origin form posts only; the API's POST /public/posts/:id/comments
 * does the rest (lib/commentWrites.ts has the rules). A browser without scripts gets a
 * 303 back to the post with `?commented=`, or this page's refusal with its text kept;
 * gl-comments.js (Accept: application/json) gets the API's JSON. Never cached, never a
 * GET, and nothing of the form is logged.
 */
import CommentRefused from '@/components/comments/CommentRefused.astro'
import { SERVER_MEDIA_URL } from '@gl-admin/lib/server-api-url'
import { isSameOriginPost } from '@/lib/designPreview'
import { PRIVATE_NO_STORE } from '@/lib/httpCache'
import { log } from '@/lib/log'
import {
  apiWriteHeaders,
  COMMENT_FORM_FIELDS,
  commentRefusal,
  commentRequestBody,
  jsonAnswer,
  plainAnswer,
  postToApi,
  readFields,
  safeReturnPath,
  seeOther,
  wantsJson,
  withCommentedNotice,
  type CommentOutcome,
} from '@/lib/commentWrites'

export const prerender = false

const { request, url } = Astro
if (request.method !== 'POST') return plainAnswer(405, 'Comments are posted with the form.', { Allow: 'POST' })
if (!isSameOriginPost(request, url)) return plainAnswer(403, 'Cross-site comment posts are refused.')
const id = Astro.params.id ?? ''
if (!/^[1-9][0-9]{0,17}$/.test(id)) return plainAnswer(404, 'Post not found.')
const form = await readFields(request)
if (!form) return plainAnswer(400, 'Expected a form.')

let clientAddress: string | undefined
try {
  clientAddress = Astro.clientAddress
} catch {
  // Not available (a test container): the API then sees this server.
}
const answer = await postToApi(`${SERVER_MEDIA_URL}/public/posts/${id}/comments`, commentRequestBody(form), apiWriteHeaders(request, clientAddress))
if (answer.status >= 500) log.warn('comment_post_failed', { status: answer.status })
if (wantsJson(request)) return jsonAnswer(answer)

const postUrl = safeReturnPath(answer.body.post_url, '/')
const back = safeReturnPath(form.get(COMMENT_FORM_FIELDS.returnTo), postUrl)
if (answer.status === 201 || answer.status === 202) {
  const outcome = (['confirm_email', 'pending', 'published'].includes(String(answer.body.outcome)) ? answer.body.outcome : 'pending') as CommentOutcome
  return seeOther(withCommentedNotice(back, outcome))
}

const refusal = commentRefusal(answer)
Astro.response.status = refusal.status
Astro.response.headers.set('Cache-Control', PRIVATE_NO_STORE)
if (answer.retryAfter && refusal.status === 429) Astro.response.headers.set('Retry-After', answer.retryAfter)
const typed = form.get(COMMENT_FORM_FIELDS.body)
---

<CommentRefused reason={refusal.reason} text={typeof typed === 'string' ? typed : ''} back={back} />
