---
import AccountPage from "@/layouts/AccountPage.astro"
import AccountError from "@/components/account/AccountError.astro"
import NewPasswordField from "@/components/account/NewPasswordField.astro"
import { PASSWORD_MIN } from "@gl-admin/lib/passwordRules"

// The design's "For <email>" line is left out: the reset token isn't
// previewable (there is no reset counterpart of /auth/invitations/preview).
---

<AccountPage title="Reset password" description="Choose a new password">
  <form class="gl-admin-login__view" id="resetForm" novalidate>
    <header class="gl-admin-login__header">
      <h1 class="gl-admin-login__title">Set a new password</h1>
    </header>

    <AccountError />

    <div class="gl-admin-login__fields">
      <NewPasswordField id="password" label="New password" toggle />
      <div class="gl-input">
        <label class="gl-input__label" for="confirm_password">Confirm new password</label>
        <input
          class="gl-input__field"
          type="password"
          id="confirm_password"
          name="confirm_password"
          required
          minlength={PASSWORD_MIN}
          autocomplete="new-password"
        />
      </div>
    </div>

    <button type="submit" class="gl-button gl-button--primary gl-admin-login__submit">
      <span class="gl-button__spinner" data-spinner aria-hidden="true" hidden></span>
      <span data-label>Set new password</span>
    </button>
    <p class="gl-admin-login__footnote">You'll be signed out everywhere, this device included.</p>
  </form>

  <!-- Expired, already used or malformed: the API answers all three the same
       (400 invalid_token), so the page can't tell them apart either. -->
  <section class="gl-admin-login__view" id="linkInvalid" role="status" hidden>
    <span class="gl-admin-login__badge gl-admin-login__badge--warning" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
        ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg
      >
    </span>
    <header class="gl-admin-login__header">
      <h1 class="gl-admin-login__title">This link has expired</h1>
      <p class="gl-admin-login__subtitle">
        Reset links work once and only for a short time. Ask for a new one and use the latest email.
      </p>
    </header>
    <a class="gl-button gl-button--primary gl-admin-login__submit" href="/forgot-password">Send a new link</a>
  </section>

  <a class="gl-admin-login__link gl-admin-login__link--small" href="/login" slot="after">Back to sign in</a>
</AccountPage>

<script>
  import { mountResetPasswordPage } from "@gl-admin/lib/accountPages"

  mountResetPasswordPage()
</script>
