---
/**
 * /comments/your-data (#525, docs/design/reader-comments.md 13.2, 11.6): "Your comments", where a
 * reader asks for a link and, with it (`#token=`), sees, downloads or deletes their comments.
 * Not served until #529 adds the endpoints and the export (`READER_PAGES_READY.yourData`): a 404
 * until then, and the privacy notice leaves out its "Your comments" link.
 */
import ThemedReaderPage from '@/components/ThemedReaderPage.astro'
import YourDataPanel from '@/components/comments/reader/YourDataPanel.astro'
import { READER_PAGES_READY } from '@/lib/postComments'

export const prerender = false

if (!READER_PAGES_READY.yourData) return new Response(null, { status: 404 })
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
Astro.response.headers.set('X-Robots-Tag', 'noindex')
---

<ThemedReaderPage title="Your comments" description="See, download or delete the comments you wrote.">
  <YourDataPanel />
</ThemedReaderPage>
