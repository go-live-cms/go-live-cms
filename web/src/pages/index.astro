---
/**
 * The front page. With a front page chosen in Settings (#336), / renders that page like
 * the post route does (components/PostPage.astro, its published template); there is no
 * list at / then, so /page/N/ is a 404. Otherwise (none chosen, or it isn't a published
 * page any more: GET /public/front-page answers 404) it is the latest published posts
 * (#345), rendered by the active theme's layouts/home layout (the default theme's when it
 * has none). Page N (#349) is /page/N/, which src/pages/[post_type]/[id].astro rewrites
 * here with Astro.locals.listPageNumber set (a published page with id N wins that URL).
 */
import { getPublicFrontPage } from "../lib/api"
import { loadPostList } from "../lib/postList"
import { pageTitleSuffix, resolveListRequest } from "../lib/pagination"
import { loadThemeLayout, themeLayoutCandidates } from "../lib/themeLayout"
import { homeTitle, resolveSiteUrl } from "../lib/seo"
import { log } from "../lib/log"
import PostPage from "../components/PostPage.astro"

export const prerender = false

const homeLayouts = import.meta.glob("../../themes/*/layouts/home/*.astro")

let page = Astro.locals.listPageNumber ?? 1
if (Astro.locals.listPageNumber === undefined) {
  const request = resolveListRequest(Astro.url, "/")
  if (request.kind === "redirect") return Astro.redirect(request.location, 301)
  if (request.kind === "notFound") return new Response(null, { status: 404 })
  page = request.page
}

// Only a 404 means "no front page": any other failure is an error (500), never the post
// list in its place.
let frontPage: Awaited<ReturnType<typeof getPublicFrontPage>> = null
try {
  frontPage = await getPublicFrontPage()
} catch (error) {
  log.error("front_page_fetch_failed", { error })
  throw error
}
if (frontPage && page > 1) {
  return new Response(null, { status: 404 })
}

const list = frontPage ? null : await loadPostList("post", page, "/", resolveSiteUrl(Astro.url), Astro.locals)
if (!frontPage && !list) {
  return new Response(null, { status: 404 })
}

const themeSlug = Astro.locals.activeTheme || "default"
const Layout = list ? await loadThemeLayout(homeLayouts, themeLayoutCandidates("../../themes", themeSlug, "home")) : null
if (list && !Layout) {
  throw new Error("No front page layout in this build")
}
// The site name, with its tagline on the first page (#357, decision 2).
const title = list ? (page === 1 ? homeTitle(list.siteTitle, list.siteTagline) : `${list.siteTitle}${pageTitleSuffix(page)}`) : ""
---

{frontPage ? (
  <PostPage
    post={frontPage.post}
    postType="page"
    publishedImage={frontPage.featured_image?.url ?? null}
    publishedTerms={frontPage.taxonomy_terms ?? []}
    publishedSeo={frontPage.seo ?? null}
  />
) : (
  /* The tagline describes the site (#330); without one, its own title does, not GoLive. */
  <Layout title={title} description={list!.siteTagline || `The latest posts from ${list!.siteTitle}`} list={list} />
)}
