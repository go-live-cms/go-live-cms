---
/**
 * The front page (#345): the latest published posts, rendered by the active theme's
 * layouts/home layout (the default theme's when it has none).
 */
import { loadPostList, pageNumber } from "../lib/postList"
import { loadThemeLayout, themeLayoutCandidates } from "../lib/themeLayout"
import { resolveSiteUrl } from "../lib/seo"

export const prerender = false

const homeLayouts = import.meta.glob("../../themes/*/layouts/home/*.astro")

const page = pageNumber(Astro.url.searchParams.get("page"))
const list = await loadPostList("post", page, "/", resolveSiteUrl(Astro.url))
if (page > 1 && list.posts.length === 0) {
  return new Response(null, { status: 404 })
}

const themeSlug = Astro.locals.activeTheme || "default"
const Layout = await loadThemeLayout(homeLayouts, themeLayoutCandidates("../../themes", themeSlug, "home"))
if (!Layout) {
  throw new Error("No front page layout in this build")
}
const title = page > 1 ? `${list.siteTitle} · Page ${page}` : list.siteTitle
---

{/* The site has no tagline setting yet (#330): describe it by its own title, not GoLive. */}
<Layout title={title} description={`The latest posts from ${list.siteTitle}`} list={list} />
