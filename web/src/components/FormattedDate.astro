---
// A date in the site's language, time zone and format (#330).
import { getSiteSettings } from '@/lib/siteSettings';
import { formatSiteDate } from '@/lib/siteDates';

interface Props {
	date: Date;
}

const { date } = Astro.props;
const site = await getSiteSettings(Astro.locals);
---

<time datetime={date.toISOString()}>
	{formatSiteDate(date, site, 'short')}
</time>
