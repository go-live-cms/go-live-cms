---
/**
 * Shared SEO <head> tags for the public site and themes (#137): title,
 * description, canonical, robots, Open Graph and Twitter card.
 *
 * Theme base layouts render it in place of their own <title>/description
 * (`<SeoHead title={title} description={description} {...seo} />`), so a theme
 * gets canonical/OG tags by forwarding the `seo` prop that
 * src/pages/[post_type]/[id].astro passes to every post layout.
 *
 * canonical defaults to the current path on the configured site URL (SITE_URL,
 * see src/lib/seo.ts), without the query string.
 *
 * The site settings (#330) fill in what an indexed page doesn't say: og:site_name is the
 * site title, and a page without a description is described by the site's tagline. A
 * noindex page (sign-in, errors) doesn't look them up: it renders without waiting on the
 * API, which may be the reason for the error.
 */
import { SITE_TITLE } from '@/consts'
import { absoluteUrl, publicImageUrl, resolveSiteUrl, type SeoMeta } from '@/lib/seo'
import { getSiteSettings } from '@/lib/siteSettings'

interface Props extends SeoMeta {
  title: string
  description?: string
}

const {
  title,
  canonical,
  prev,
  next,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props
const site = noindex ? null : await getSiteSettings(Astro.locals)
const siteName = Astro.props.siteName ?? site?.title ?? SITE_TITLE
const description = Astro.props.description || site?.tagline || undefined

const siteUrl = resolveSiteUrl(Astro.url)
const canonicalUrl = canonical ? absoluteUrl(siteUrl, canonical) : absoluteUrl(siteUrl, Astro.url.pathname)
const imageUrl = publicImageUrl(siteUrl, image)
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <link rel="canonical" href={canonicalUrl} />
)}
{prev && <link rel="prev" href={absoluteUrl(siteUrl, prev)} />}
{next && <link rel="next" href={absoluteUrl(siteUrl, next)} />}
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{!noindex && <meta property="og:url" content={canonicalUrl} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
