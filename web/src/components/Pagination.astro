---
/**
 * The numbered pager under a public list (#349): "← Newer · 1 2 3 … 5 · Page 1 of 5 ·
 * Older →". Shared by every list (front page, post types; terms #348, authors #350,
 * search #145); the theme styles the class names (.pagination, .page-link, .page-num,
 * .page-status). Nothing renders for a single page. URLs and the window come from
 * src/lib/pagination.ts.
 */
import { pageLinks, pagePath, pageWindow } from '@/lib/pagination'

interface Props {
  page: number
  totalPages: number
  // Page 1's URL, e.g. "/" or "/post".
  basePath: string
  // A query string every link keeps, e.g. "?q=alt" on search (#145).
  query?: string
  // The arrows' words: lists run newest first, search best match first.
  previousLabel?: string
  nextLabel?: string
}

const { page, totalPages, basePath, query = '', previousLabel = 'Newer', nextLabel = 'Older' } = Astro.props
const links = pageLinks(basePath, page, totalPages)
const slots = pageWindow(page, totalPages)
const withQuery = (href: string) => `${href}${query}`
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pages">
    {links.newer ? <a href={withQuery(links.newer)} class="page-link" rel="prev">← {previousLabel}</a> : <span class="page-link" aria-disabled="true">← {previousLabel}</span>}
    {slots.map((slot) =>
      slot === 'gap' ? (
        <span class="page-link page-num" aria-hidden="true">…</span>
      ) : slot === page ? (
        <a href={withQuery(pagePath(basePath, slot))} class="page-link page-num" aria-current="page">{slot}</a>
      ) : (
        <a href={withQuery(pagePath(basePath, slot))} class="page-link page-num">{slot}</a>
      ),
    )}
    <span class="page-status">Page {page} of {totalPages}</span>
    {links.older ? <a href={withQuery(links.older)} class="page-link" rel="next">{nextLabel} →</a> : <span class="page-link" aria-disabled="true">{nextLabel} →</span>}
  </nav>
)}
