---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "@/assets/styles/global.css"
import type { ImageMetadata } from "astro"
import FallbackImage from "../assets/blog-placeholder-1.jpg"
import SeoHead from "./SeoHead.astro"
import { SITE_TITLE } from "../consts"
import { absoluteUrl, resolveSiteUrl } from "../lib/seo"

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  noindex?: boolean
}

const { title, description, image = FallbackImage, noindex = false } = Astro.props
const siteUrl = resolveSiteUrl(Astro.url)
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={absoluteUrl(siteUrl, "/rss.xml")} />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Title, description, canonical, robots, Open Graph, Twitter -->
<SeoHead title={title} description={description} image={image.src} noindex={noindex} />
