---
/**
 * "Your comment wasn't posted" (#524, docs/design/reader-comments.md 9.4): the page the
 * comment endpoint answers a browser without scripts when the API refuses a comment
 * (422, 429, or 503 when it couldn't answer). Nothing is kept on the server, so the typed
 * text is shown back, read-only, to copy, with Back to the post.
 *
 * #525: a reader page in the active theme (ThemedReaderPage: the header, this panel, the
 * footer; noindex), the canvas's "comment refused without scripts" board. Core markup
 * (`.reader-panel`, `.comment-field`, `.reader-actions`), which the theme styles.
 */
import ThemedReaderPage from '@/components/ThemedReaderPage.astro'

interface Props {
  reason: string
  // What the reader typed, shown back to copy (rendered as text, never markup).
  text: string
  // Where Back to the post goes: a path on this site.
  back: string
}

const { reason, text, back } = Astro.props
const title = "Your comment wasn't posted"
---

<ThemedReaderPage title={title} description={reason}>
  <section class="reader-panel comment-refused" aria-labelledby="comment-refused-title">
    <h1 id="comment-refused-title">Your comment wasn’t posted</h1>
    <p class="comment-refused-reason" role="alert">{reason}</p>
    {text && (
      <div class="comment-field comment-refused-text">
        <label for="comment-refused-copy">Your text, to copy</label>
        <textarea id="comment-refused-copy" class="input" readonly rows="6">{text}</textarea>
      </div>
    )}
    <div class="reader-actions"><a class="btn btn-primary comment-refused-back" href={back}>Back to the post</a></div>
  </section>
</ThemedReaderPage>
