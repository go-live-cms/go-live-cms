---
// A new-password field with the API's minimum as a live hint (lib/accountPages.ts
// wirePasswordRules) and, optionally, a Show / Hide button (wirePasswordToggles).
// PASSWORD_MIN is the API's MinPasswordLength (passwordRules.test.ts), so the hint and
// minlength can't drift from what the server enforces.
import { PASSWORD_DETAILS_RULE, PASSWORD_MIN, passwordRule } from "@gl-admin/lib/passwordRules"

interface Props {
  id: string
  label: string
  toggle?: boolean
}

const { id, label, toggle = false } = Astro.props
const ruleId = `${id}-rule`
// The API also refuses the account's email, username or name (#329). Stated, not
// checked live: the reset page doesn't know them, and submitting reports a match.
const detailsId = `${id}-details`
const describedBy = `${ruleId} ${detailsId}`
const { text } = passwordRule("")
---

<div class="gl-input">
  <label class="gl-input__label" for={id}>{label}</label>
  {
    toggle ? (
      <div class="gl-admin-login__password">
        <input
          class="gl-input__field"
          type="password"
          id={id}
          name={id}
          required
          minlength={PASSWORD_MIN}
          autocomplete="new-password"
          aria-describedby={describedBy}
        />
        <button type="button" class="gl-admin-login__reveal" data-password-toggle={id} aria-controls={id}>
          <span data-toggle-text>Show</span><span class="gl-visually-hidden"> password</span>
        </button>
      </div>
    ) : (
      <input
        class="gl-input__field"
        type="password"
        id={id}
        name={id}
        required
        minlength={PASSWORD_MIN}
        autocomplete="new-password"
        aria-describedby={describedBy}
      />
    )
  }
  <p class="gl-field__hint gl-admin-login__rule" id={ruleId} data-password-rule={id}>
    <svg class="gl-admin-login__rule-todo" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
      ><circle cx="12" cy="12" r="8"></circle></svg
    >
    <svg class="gl-admin-login__rule-done" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M20 6 9 17l-5-5"></path></svg
    >
    <span data-rule-text>{text}</span>
  </p>
  <p class="gl-field__hint" id={detailsId}>{PASSWORD_DETAILS_RULE}</p>
</div>
