---
import Page from "../Page.astro"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import FormattedDate from "@/components/FormattedDate.astro"
import BlockRenderer from "@/components/BlockRenderer"
import type { BlockDocV1 } from "@gl-admin/lib/blocks-spec"

type Props = CollectionEntry<'blog'>['data'] & {
  postId?: number;
};

const { title, description, pubDate, updatedDate, heroImage, postId } = Astro.props;

// Fetch published blocks if postId exists
let blockDoc: BlockDocV1 | null = null;
if (postId) {
  try {
    const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
    const response = await fetch(`${apiUrl}/public/posts/${postId}/blocks`);
    if (response.ok) {
      const data = await response.json();
      blockDoc = data.doc;
    }
  } catch (e) {
    console.error('Failed to fetch blocks:', e);
  }
}
---

<Page {title} {description}>
	<Fragment slot="head">
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			
			/* Block content styles */
			.block-content {
				line-height: 1.6;
			}
			
			.block-content p {
				margin-bottom: 1em;
			}
			
			.block-content h1,
			.block-content h2,
			.block-content h3 {
				margin-top: 1.5em;
				margin-bottom: 0.5em;
				font-weight: 600;
			}
			
			.block-content ul,
			.block-content ol {
				margin-bottom: 1em;
				padding-left: 2em;
			}
			
			.block-content li {
				margin-bottom: 0.5em;
			}
			
			.block-content blockquote {
				margin: 1em 0;
				padding-left: 1em;
				border-left: 4px solid rgb(var(--accent));
				font-style: italic;
				color: rgb(var(--gray));
			}
			
			.block-content pre {
				margin: 1em 0;
				padding: 1em;
				background: #f5f5f5;
				border-radius: 4px;
				overflow-x: auto;
			}
			
			.block-content pre code {
				background: none;
				padding: 0;
			}
			
			.block-content img {
				max-width: 100%;
				height: auto;
				margin: 1em 0;
				border-radius: 8px;
			}
			
			.block-content hr {
				margin: 2em 0;
				border: none;
				border-top: 2px solid #e0e0e0;
			}
		</style>
	</Fragment>
	<main>
		<article>
			<div class="hero-image">
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
			</div>
			<div class="prose">
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
				</div>
				
				{blockDoc && blockDoc.blocks_order && blockDoc.blocks_order.length > 0 ? (
					<BlockRenderer doc={blockDoc} client:load />
				) : (
					<slot />
				)}
			</div>
		</article>
	</main>
</Page>
