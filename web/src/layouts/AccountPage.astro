---
// Shell of the signed-out account pages (/login, forgot/reset password, accept
// invite; redesign #344): the logo above one card, an optional line below it.
// Each page puts its views (a form, then result panels) in the card. Their
// logic is in gl-admin/lib/accountPages.ts and loginPage.ts; each page's
// <script> only mounts it (no inline script, admin CSP #161).
import Head from "@/layouts/Page/Head.astro"
import { SITE_TITLE } from "@/consts"
import GLLogo from "@gl-admin/assets/gl-logo.svg?raw"
import "@gl-admin/assets/styles/pages/login.scss"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

// Emailed links hold a token (in the fragment, but be safe), and /login may
// carry a redirect: never cache these pages.
Astro.response.headers.set("Cache-Control", "no-store")
---

<!doctype html>
<html lang="en">
<head>
<!-- noindex: Head then emits robots noindex and no canonical/og:url (#137). -->
<Head title={`${title} - ${SITE_TITLE}`} description={description} noindex>
  <meta name="referrer" content="no-referrer" />
</Head>
</head>
<body>
<div class="gl-admin-login">
  <p class="gl-admin-login__brand">
    <span class="gl-admin-login__logo" aria-hidden="true" set:html={GLLogo} />
    GoLive
  </p>

  <main class="gl-admin-login__card">
    <slot />
  </main>

  <slot name="after" />
</div>
</body>
</html>
