---
import Head from "./Page/Head.astro"
import Header from "./Header.astro"
import Footer from "./Footer.astro"

import "@/assets/styles/global.css"
import { getSiteSettings } from "@/lib/siteSettings"

import type { ImageMetadata } from "astro"

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  noindex?: boolean
}

const { title, description, image, noindex } = Astro.props
// The site's language (#481, WCAG 3.1.1), like the theme's pages.
const { language } = await getSiteSettings(Astro.locals)
---

<!doctype html>
<html lang={language}>
  <head>
    <Head title={title} description={description} image={image || undefined} noindex={noindex}>
      <slot name="head" />
    </Head>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <slot name="foot" />
  </body>
</html>
