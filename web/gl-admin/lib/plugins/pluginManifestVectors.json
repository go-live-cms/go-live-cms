{
  "_comment": "plugin.json cases shared by the Go validator (api/plugins_manifest.go, TestPluginManifestVectors) and the admin's (manifest.ts, manifest.test.ts). Each case is `replace` if given, else `base` with `set`'s top-level keys merged over it (a null value deletes the key), checked as the plugin.json of directory `dir` (default: the base id). `field` is the path of the first problem both must report.",
  "base": {
    "manifest_version": 1,
    "id": "reading-time",
    "name": "Reading time",
    "version": "1.2.0",
    "author": "Ana Costa",
    "description": "Adds an estimated reading time block.",
    "plugin_api": 1,
    "capabilities": ["posts:read"],
    "blocks": ["Estimate"],
    "settings": {
      "words_per_minute": {
        "type": "number", "integer": true, "minimum": 50, "maximum": 600,
        "default": 200, "label": "Words per minute"
      }
    },
    "server": {
      "hooks": [
        { "event": "post.published", "timeout_ms": 5000 },
        { "event": "post.before_publish", "on_error": "allow" }
      ]
    }
  },
  "cases": [
