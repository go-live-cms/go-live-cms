    { "name": "every hook event", "valid": true, "set": { "server": { "hooks": [
      { "event": "post.saved" }, { "event": "post.published" }, { "event": "post.unpublished" },
      { "event": "post.trashed" }, { "event": "post.restored" }, { "event": "post.deleted", "timeout_ms": 30000 },
      { "event": "post.before_publish", "on_error": "deny", "priority": -1000 }
    ] } } },
    { "name": "string, select and boolean settings", "valid": true, "set": { "settings": {
