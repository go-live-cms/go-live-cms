{
  "_comment": "block.json cases shared by the Go validator (api/plugin_blocks.go, TestPluginBlockVectors) and the admin's (blockJson.ts, blockJson.test.ts). Each case is `replace` if given, else `base` with `set`'s top-level keys merged over it (a null value deletes the key, so `null_set` sets a key to JSON null), checked as plugins/<slug>/blocks/<dir>/block.json (default: the base slug and dir). `field` is the path of the first problem both must report.",
  "slug": "reading-time",
  "dir": "Estimate",
  "base": {
    "type": "plugin:reading-time/estimate",
    "version": 1,
    "title": "Reading time",
    "content": "",
    "attrs": {
      "label": { "type": "string", "default": "min read", "maxLength": 40 }
    }
  },
  "cases": [
    { "name": "the design's example", "valid": true },
    { "name": "only the required fields", "valid": true, "replace": { "type": "plugin:reading-time/estimate", "version": 1, "title": "Reading time" } },
    { "name": "text content with marks", "valid": true, "set": { "content": "inline*", "marks": "bold italic link" } },
    { "name": "text blocks inside", "valid": true, "set": { "content": "(paragraph | heading)+" } },
    { "name": "every attr type", "valid": true, "set": { "attrs": {
      "label": { "type": "string", "default": "a", "enum": ["a", "b"], "maxLength": 10 },
      "count": { "type": "number", "default": 2, "integer": true, "minimum": 1, "maximum": 5, "enum": [1, 2, 3] },
      "shown": { "type": "boolean", "default": false }
    } } },
    { "name": "empty attrs", "valid": true, "set": { "attrs": {} } },
    { "name": "a newer version", "valid": true, "set": { "version": 7 } },
    { "name": "a directory with digits", "valid": true, "dir": "Estimate2", "set": { "type": "plugin:reading-time/estimate2" } },

    { "name": "not an object", "valid": false, "field": "", "replace": ["plugin:reading-time/estimate"] },
    { "name": "an unknown field", "valid": false, "field": "editor", "set": { "editor": "./editor.ts" } },
    { "name": "unknown fields report the first in byte order", "valid": false, "field": "Zeta", "set": { "Zeta": 1, "zeta": 2 } },
    { "name": "type missing", "valid": false, "field": "type", "set": { "type": null } },
    { "name": "type of another plugin", "valid": false, "field": "type", "set": { "type": "plugin:other/estimate" } },
    { "name": "type not the directory's", "valid": false, "field": "type", "set": { "type": "plugin:reading-time/other" } },
    { "name": "a theme type", "valid": false, "field": "type", "set": { "type": "theme:reading-time/estimate" } },
    { "name": "type keeps the directory's case", "valid": false, "field": "type", "set": { "type": "plugin:reading-time/Estimate" } },
    { "name": "type not a string", "valid": false, "field": "type", "set": { "type": 1 } },
    { "name": "version missing", "valid": false, "field": "version", "set": { "version": null } },
    { "name": "version zero", "valid": false, "field": "version", "set": { "version": 0 } },
    { "name": "version not an integer", "valid": false, "field": "version", "set": { "version": 1.5 } },
    { "name": "version a string", "valid": false, "field": "version", "set": { "version": "1" } },
    { "name": "version too large", "valid": false, "field": "version", "set": { "version": 1000001 } },
    { "name": "title missing", "valid": false, "field": "title", "set": { "title": null } },
    { "name": "title blank", "valid": false, "field": "title", "set": { "title": " \t" } },
    { "name": "title not a string", "valid": false, "field": "title", "set": { "title": 5 } },
    { "name": "title too long", "valid": false, "field": "title", "set": { "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
    { "name": "content naming a block group", "valid": false, "field": "content", "set": { "content": "block+" } },
    { "name": "content naming an image", "valid": false, "field": "content", "set": { "content": "paragraph image" } },
    { "name": "content naming a list", "valid": false, "field": "content", "set": { "content": "bulletList" } },
    { "name": "content with odd characters", "valid": false, "field": "content", "set": { "content": "inline*; drop" } },
    { "name": "content not a string", "valid": false, "field": "content", "set": { "content": 1 } },
    { "name": "content null", "valid": false, "field": "content", "null_set": ["content"] },
    { "name": "marks with odd characters", "valid": false, "field": "marks", "set": { "marks": "bold,italic" } },
    { "name": "marks not a string", "valid": false, "field": "marks", "set": { "marks": ["bold"] } },
    { "name": "attrs null", "valid": false, "field": "attrs", "null_set": ["attrs"] },
    { "name": "attrs an array", "valid": false, "field": "attrs", "set": { "attrs": [] } },
    { "name": "a reserved attr name", "valid": false, "field": "attrs.pm", "set": { "attrs": { "pm": { "type": "string", "default": "" } } } },
    { "name": "an on* attr name", "valid": false, "field": "attrs.onClick", "set": { "attrs": { "onClick": { "type": "string", "default": "" } } } },
    { "name": "an attr name with a dash", "valid": false, "field": "attrs.data-x", "set": { "attrs": { "data-x": { "type": "string", "default": "" } } } },
    { "name": "attrs report the first in byte order", "valid": false, "field": "attrs.a.type", "set": { "attrs": { "b": { "type": "bogus" }, "a": { "type": "bogus" } } } },
    { "name": "an attr not an object", "valid": false, "field": "attrs.label", "set": { "attrs": { "label": "string" } } },
    { "name": "an attr without a type", "valid": false, "field": "attrs.label.type", "set": { "attrs": { "label": { "default": "" } } } },
    { "name": "an unsupported attr type", "valid": false, "field": "attrs.label.type", "set": { "attrs": { "label": { "type": "object", "default": {} } } } },
    { "name": "a field of another type", "valid": false, "field": "attrs.label.integer", "set": { "attrs": { "label": { "type": "string", "default": "", "integer": true } } } },
    { "name": "an unknown attr field", "valid": false, "field": "attrs.label.label", "set": { "attrs": { "label": { "type": "string", "default": "", "label": "Label" } } } },
    { "name": "a boolean with an enum", "valid": false, "field": "attrs.shown.enum", "set": { "attrs": { "shown": { "type": "boolean", "default": true, "enum": [true] } } } },
    { "name": "integer not a boolean", "valid": false, "field": "attrs.count.integer", "set": { "attrs": { "count": { "type": "number", "default": 1, "integer": "yes" } } } },
    { "name": "minimum not a number", "valid": false, "field": "attrs.count.minimum", "set": { "attrs": { "count": { "type": "number", "default": 1, "minimum": "1" } } } },
    { "name": "maximum below minimum", "valid": false, "field": "attrs.count.maximum", "set": { "attrs": { "count": { "type": "number", "default": 1, "minimum": 2, "maximum": 1 } } } },
    { "name": "maxLength zero", "valid": false, "field": "attrs.label.maxLength", "set": { "attrs": { "label": { "type": "string", "default": "", "maxLength": 0 } } } },
    { "name": "maxLength not an integer", "valid": false, "field": "attrs.label.maxLength", "set": { "attrs": { "label": { "type": "string", "default": "", "maxLength": 2.5 } } } },
    { "name": "an empty enum", "valid": false, "field": "attrs.label.enum", "set": { "attrs": { "label": { "type": "string", "default": "a", "enum": [] } } } },
    { "name": "an enum value of the wrong type", "valid": false, "field": "attrs.label.enum[1]", "set": { "attrs": { "label": { "type": "string", "default": "a", "enum": ["a", 2] } } } },
    { "name": "an enum value twice", "valid": false, "field": "attrs.count.enum[2]", "set": { "attrs": { "count": { "type": "number", "default": 1, "enum": [1, 2, 1] } } } },
    { "name": "a default missing", "valid": false, "field": "attrs.label.default", "set": { "attrs": { "label": { "type": "string" } } } },
    { "name": "a null default", "valid": false, "field": "attrs.label.default", "set": { "attrs": { "label": { "type": "string", "default": null } } } },
    { "name": "a default of the wrong type", "valid": false, "field": "attrs.label.default", "set": { "attrs": { "label": { "type": "string", "default": 3 } } } },
    { "name": "a default outside the enum", "valid": false, "field": "attrs.label.default", "set": { "attrs": { "label": { "type": "string", "default": "c", "enum": ["a", "b"] } } } },
    { "name": "a default longer than maxLength", "valid": false, "field": "attrs.label.default", "set": { "attrs": { "label": { "type": "string", "default": "abcdef", "maxLength": 3 } } } },
    { "name": "a default below minimum", "valid": false, "field": "attrs.count.default", "set": { "attrs": { "count": { "type": "number", "default": 0, "minimum": 1 } } } },
    { "name": "a fractional default of an integer", "valid": false, "field": "attrs.count.default", "set": { "attrs": { "count": { "type": "number", "default": 1.5, "integer": true } } } },
    { "name": "a boolean default as a string", "valid": false, "field": "attrs.shown.default", "set": { "attrs": { "shown": { "type": "boolean", "default": "true" } } } }
  ]
}
