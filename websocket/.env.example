# WebSocket Server Configuration
HOST=0.0.0.0
PORT=1234
NODE_ENV=development

# PASETO v4.public Authentication Configuration  
# These should match your Go API's PASETO settings
PASETO_ISSUER=golive.auth

# Sockets authenticate with single-use collab tickets minted by
# POST /api/v1/collab/tickets (audience golive.admin-ws, fixed in code), never with
# access tokens (#233). PASETO_AUDIENCE / PASETO_ALLOWED_AUDIENCES are no longer read.

# PASETO v4.public Ed25519 public key (choose ONE method)

# Method 1: File path (recommended - avoids multiline env issues)
PASETO_V4_PUBLIC_PEM_FILE=/run/secrets/public.pem

# Method 2: Direct PEM string (avoid for Docker env files)
# PASETO_V4_PUBLIC_PEM="-----BEGIN PUBLIC KEY-----
# REPLACE_WITH_OUTPUT_FROM_go_run_cmd/export-pubkey/main.go
# -----END PUBLIC KEY-----"

# Method 3: Base64 encoded PEM (single line alternative)
# PASETO_V4_PUBLIC_PEM_B64="LS0tLS1CRUdJTi..."

# LevelDB persistence
# Path where Yjs document snapshots are stored on disk
# Docker overrides this to /data/yjs via compose environment block
DATA_PATH=./data

# Squash endpoint shared secret
# Must match COLLAB_SQUASH_SECRET in the Go API's app.env
SQUASH_SECRET=change-me-in-production

# Go API base URL (required)
# Each WS upgrade redeems its ticket at ${API_URL}/collab/tickets/redeem, which
# also returns the caller's current role; only admins and editors may connect. Docker sets this to http://api:8080/api/v1.
API_URL=http://localhost:8080/api/v1

# Setup Instructions:
# 1. Run the automated setup: ./scripts/gen-ws-env.sh
# 2. Or manually:
#    - Copy this file to .env
#    - Run: go run cmd/export-pubkey/main.go > websocket/public.pem
#    - Use file-based method above
# 3. Start: docker compose -f compose.dev.yaml up --build