# WebSocket Server Configuration
HOST=0.0.0.0
PORT=1234
NODE_ENV=development

# PASETO v4.public Authentication Configuration  
# These should match your Go API's PASETO settings
PASETO_ISSUER=golive.auth
PASETO_AUDIENCE=golive.admin-ws

# Support multiple audiences (comma-separated)
# This allows tokens issued for different services to work
# Keep golive.admin while migrating, remove later when using WS-specific tokens
PASETO_ALLOWED_AUDIENCES=golive.admin-ws,golive.auth,golive.admin

# PASETO v4.public Ed25519 public key (choose ONE method)

# Method 1: Direct PEM string (recommended for development)
PASETO_V4_PUBLIC_PEM="-----BEGIN PUBLIC KEY-----
REPLACE_WITH_OUTPUT_FROM_go_run_cmd/export-pubkey/main.go
-----END PUBLIC KEY-----"

# Method 2: Base64 encoded PEM (alternative)
# PASETO_V4_PUBLIC_PEM_B64="LS0tLS1CRUdJTi..."

# Method 3: File path (recommended for production)  
# PASETO_V4_PUBLIC_PEM_FILE="/run/secrets/public.pem"

# Setup Instructions:
# 1. Copy this file to .env
# 2. Run: go run cmd/export-pubkey/main.go
# 3. Replace the PASETO_V4_PUBLIC_PEM value with the output
# 4. Or use the automated script: ./scripts/gen-ws-env.sh