		<content:encoded><![CDATA[<!-- wp:heading -->
<h2 class="wp-block-heading">Before you start</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Export your site from <strong>Tools › Export</strong>, then <em>keep the file</em> somewhere safe. It holds <code>posts</code>, <mark style="background-color:#ff0" class="has-inline-color">pages</mark> and H<sub>2</sub>O<sup>2</sup>.</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Posts and pages</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Categories <s>and</s> tags<!-- wp:list {"ordered":true} -->
<ol class="wp-block-list"><!-- wp:list-item -->
<li>Nested one</li>
<!-- /wp:list-item --></ol>
<!-- /wp:list --></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><!-- wp:paragraph -->
<p>Simple things should be simple.</p>
<!-- /wp:paragraph --><cite>Alan Kay</cite></blockquote>
<!-- /wp:quote -->

<!-- wp:pullquote -->
<figure class="wp-block-pullquote"><blockquote><p>Moving is easier than you think.</p><cite>The team</cite></blockquote></figure>
<!-- /wp:pullquote -->

<!-- wp:code -->
<pre class="wp-block-code"><code>wp export --dir=/tmp &amp;&amp; ls</code></pre>
<!-- /wp:code -->

<!-- wp:image {"id":10,"sizeSlug":"large","linkDestination":"none","align":"wide"} -->
<figure class="wp-block-image alignwide size-large"><img src="https://example.com/wp-content/uploads/2024/05/bike-1024x683.jpg" alt="Bike by the canal" class="wp-image-10"/><figcaption class="wp-element-caption">The <strong>bike</strong>, in <a href="https://example.com/places/">Amsterdam</a></figcaption></figure>
<!-- /wp:image -->

<!-- wp:gallery {"columns":2,"linkTo":"none"} -->
<figure class="wp-block-gallery has-nested-images columns-2 is-cropped"><!-- wp:image {"id":12,"sizeSlug":"large"} -->
<figure class="wp-block-image size-large"><img src="https://example.com/wp-content/uploads/2024/05/harbour-1024x768.jpg" alt="" class="wp-image-12"/></figure>
<!-- /wp:image -->

<!-- wp:image {"id":13,"sizeSlug":"large"} -->
<figure class="wp-block-image size-large"><img src="https://example.com/wp-content/uploads/2024/05/market.jpg" alt="Fruit stalls" class="wp-image-13"/></figure>
<!-- /wp:image --><figcaption class="blocks-gallery-caption wp-element-caption">Two views of the town</figcaption></figure>
<!-- /wp:gallery -->

<!-- wp:embed {"url":"https://vimeo.com/76979871","type":"video","providerNameSlug":"vimeo","responsive":true} -->
<figure class="wp-block-embed is-type-video is-provider-vimeo wp-block-embed-vimeo"><div class="wp-block-embed__wrapper">
https://vimeo.com/76979871
</div><figcaption class="wp-element-caption">A short film</figcaption></figure>
<!-- /wp:embed -->

<!-- wp:embed {"url":"https://www.tiktok.com/@someone/video/123","type":"video","providerNameSlug":"tiktok"} -->
<figure class="wp-block-embed is-type-video is-provider-tiktok"><div class="wp-block-embed__wrapper">
https://www.tiktok.com/@someone/video/123
</div></figure>
<!-- /wp:embed -->

<!-- wp:table -->
<figure class="wp-block-table"><table><thead><tr><th>Step</th><th>Time</th></tr></thead><tbody><tr><td>Export</td><td>5 min</td></tr><tr><td><strong>Import</strong></td><td>10 min</td></tr></tbody></table><figcaption class="wp-element-caption">A typical afternoon</figcaption></figure>
<!-- /wp:table -->

<!-- wp:separator -->
<hr class="wp-block-separator has-alpha-channel-opacity"/>
<!-- /wp:separator -->

<!-- wp:spacer {"height":"60px"} -->
